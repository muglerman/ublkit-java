<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
{% set cp = doc.remitente %}
{% set tercero = doc.tercero %}
{% set cl = doc.destinatario %}
{% set name = doc.tipoComprobante|catalog('01') %}
{% set docNumber = doc.serie ~ '-' ~ (doc.numero|str_pad(8, '0', 'left')) %}
{% set hasSubcontratante = doc.subcontratado is not null and (doc.subcontratado.nombre is not empty or doc.subcontratado.numeroDocumentoIdentidad is not empty or doc.subcontratado.numeroRegistroMTC is not empty) %}
{% set hasSubcontratista = params.subcontratistaNombre is not empty or params.subcontratistaRuc is not empty or params.subcontratistaMtc is not empty %}
{% set hasSubcontratacion = hasSubcontratante or hasSubcontratista %}
{% set hasIndicadoresTraslado = indicadoresTraslado is defined and indicadoresTraslado is not empty %}
{% set hasClosing = doc.documentosRelacionados is not empty or doc.observaciones is not empty %}
<title>{{ docNumber }} · {{ name }}</title>
<style>
  {{ fontStyle | raw }}
  @page { size: A4 portrait; margin: 0; }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: #fbfaf4; }
  :root {
    --page-width: 794px;
    --page-height: 1123px;
    --ink: #0f0f10;
    --ink-2: #4a4a50;
    --ink-3: #8c8c94;
    --accent: #ff5a1f;
    --accent-soft: #fff1ea;
    --line: #e8e6df;
    --paper: #fbfaf4;
  }
  body { font-family: 'Archivo', sans-serif; font-size: 10.5px; line-height: 1.45; color: var(--ink); background: var(--paper); width: var(--page-width); margin: 0 auto; }
  .mono { font-family: 'JetBrains Mono', monospace; font-variant-numeric: tabular-nums; }
  p, h1, h2, h3 { margin: 0; }

  .page { width: var(--page-width); height: var(--page-height); min-height: var(--page-height); padding: 36px 40px; overflow: hidden; background: var(--paper); break-after: page; page-break-after: always; }
  .page:last-child { break-after: auto; page-break-after: auto; }
  .page-shell { height: 100%; display: flex; flex-direction: column; min-height: 0; }
  .source-only { position: fixed; top: 0; left: -200vw; width: var(--page-width); visibility: hidden; pointer-events: none; }

  .hero { display: grid; grid-template-columns: 1fr 290px; gap: 24px; align-items: stretch; margin-bottom: 16px; }
  .hero .left { padding: 22px 24px; border: 1.5px solid var(--ink); border-radius: 4px; background: #fff; }
  .hero .left .mark { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
  .hero .left .logo { width: 56px; height: 56px; color: var(--accent); display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .hero .left .logo img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
  .hero .left .logo svg { width: 34px; height: 34px; }
  .hero .left .co-name { font-size: 17px; font-weight: 900; letter-spacing: -0.01em; line-height: 1.1; }
  .hero .left .co-tag { font-size: 10px; color: var(--ink-2); margin-top: 2px; font-weight: 500; }
  .hero .left .info { font-size: 10px; color: var(--ink-2); }
  .hero .left .info p { padding: 1px 0; overflow-wrap: anywhere; }
  .hero .left .info b { color: var(--ink); font-family: 'JetBrains Mono', monospace; }
  .issuer-label { display: inline-block; min-width: 76px; margin-right: 8px; color: var(--ink-2); font-size: 9px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }

  .hero .right { padding: 20px 22px; background: var(--ink); color: #fff; border-radius: 4px; display: flex; flex-direction: column; justify-content: space-between; }
  .hero .right .kind { font-size: 12px; font-weight: 700; color: var(--accent); letter-spacing: 0.04em; text-transform: uppercase; }
  .hero .right .subkind { font-size: 10px; opacity: 0.7; margin-top: 1px; }
  .hero .right .num { font-family: 'JetBrains Mono', monospace; font-size: 24px; font-weight: 700; margin-top: 4px; letter-spacing: 0.02em; }
  .hero .right .rule { height: 1px; background: rgba(255,255,255,0.18); margin: 12px 0; }
  .hero .right .row { display: flex; justify-content: space-between; font-size: 10px; padding: 1.5px 0; gap: 12px; }
  .hero .right .row .k { opacity: 0.62; }
  .hero .right .row .v { font-weight: 500; text-align: right; }
  .tracking-number { font-size: 10px !important; font-weight: 500 !important; letter-spacing: 0.02em; }

  .continuation-header {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 14px;
    align-items: end;
    margin-bottom: 14px;
    padding: 14px 18px;
    background: #fff;
    border: 1.5px solid var(--ink);
    border-radius: 4px;
  }
  .continuation-header .tag { font-size: 9px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--accent); font-weight: 700; }
  .continuation-header .ruc { font-size: 10px; color: var(--ink-2); text-transform: uppercase; letter-spacing: 0.12em; }
  .continuation-header .num { font-family: 'JetBrains Mono', monospace; font-size: 20px; font-weight: 700; color: var(--ink); }

  .route { background: var(--accent); color: var(--ink); border-radius: 4px; padding: 14px 18px; display: grid; grid-template-columns: 1fr auto 1fr; gap: 16px; align-items: center; margin-bottom: 14px; break-inside: avoid; page-break-inside: avoid; }
  .route .leg .k { font-size: 9px; text-transform: uppercase; letter-spacing: 0.16em; font-weight: 800; }
  .route .leg .v { font-size: 12.5px; font-weight: 800; margin-top: 2px; overflow-wrap: anywhere; }
  .route .leg .a { font-size: 9.5px; font-weight: 500; margin-top: 1px; overflow-wrap: anywhere; }
  .route .arrow { font-size: 22px; font-weight: 900; }
  .route .leg.right { text-align: right; }

  .strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 14px; }
  .strip .chip { background: #fff; border: 1px solid var(--line); border-radius: 4px; padding: 9px 12px; break-inside: avoid; page-break-inside: avoid; }
  .strip .chip .k { font-size: 8.5px; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.12em; font-weight: 700; display: block; margin-bottom: 2px; }
  .strip .chip .v { font-size: 11px; font-weight: 600; overflow-wrap: anywhere; }

  .parties { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 14px; }
  .party { background: #fff; border-radius: 4px; border: 1px solid var(--line); padding: 14px 16px; position: relative; break-inside: avoid; page-break-inside: avoid; }
  .party::before { content: ""; position: absolute; left: 0; top: 14px; bottom: 14px; width: 3px; background: var(--accent); border-radius: 0 2px 2px 0; }
  .party .label { font-size: 9px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--accent); font-weight: 700; margin-bottom: 4px; }
  .party .name { font-size: 11.5px; font-weight: 700; margin-bottom: 5px; letter-spacing: -0.005em; overflow-wrap: anywhere; }
  .party .row { display: grid; grid-template-columns: 72px 1fr; font-size: 10px; padding: 1px 0; min-width: 0; }
  .party .row .k { color: var(--ink-3); }
  .party .row span:last-child { min-width: 0; overflow-wrap: anywhere; }

  .stack { display: grid; gap: 12px; margin-bottom: 14px; }
  .subgrid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  .subcontract-fields { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .subcontract-field .k { display: block; color: var(--ink-3); font-size: 8.5px; text-transform: uppercase; letter-spacing: 0.12em; }
  .subcontract-field .v { display: block; margin-top: 2px; font-size: 10px; overflow-wrap: anywhere; }
  .pill-list { display: flex; flex-wrap: wrap; gap: 8px; }
  .pill { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; background: var(--accent-soft); border: 1px solid var(--line); font-size: 9.5px; font-weight: 700; }

  .transport { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 14px; break-inside: avoid; page-break-inside: avoid; }
  .transport .card { background: var(--ink); color: #fff; border-radius: 4px; padding: 14px 16px; }
  .transport .card .head { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
  .transport .card .head .icon { color: var(--accent); }
  .transport .card .head .title { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); }
  .transport .card .row { display: grid; grid-template-columns: 84px 1fr; font-size: 10px; padding: 1.5px 0; }
  .transport .card .row .k { opacity: 0.6; }
  .veh { display: grid; grid-template-columns: 76px 1fr; gap: 8px; padding: 5px 0; border-top: 1px solid rgba(255,255,255,0.18); }
  .veh:first-of-type { border-top: 0; }
  .veh .veh-label { font-size: 9px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); font-weight: 600; }
  .vehicle-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 5px 12px; }
  .vehicle-field { display: flex; align-items: baseline; gap: 4px; min-width: 0; white-space: nowrap; }
  .vehicle-field .k { display: inline; flex: 0 0 auto; font-size: 8.5px; text-transform: uppercase; letter-spacing: 0.12em; opacity: 0.6; }
  .vehicle-field .v { display: inline; min-width: 0; margin-top: 0; font-size: 10px; font-weight: 500; overflow-wrap: anywhere; white-space: normal; }

  .items-section { display: flex; flex-direction: column; min-height: 0; break-inside: avoid; page-break-inside: avoid; }
  .items-card { background: #fff; border-radius: 4px; border: 1px solid var(--line); overflow: hidden; display: flex; flex-direction: column; min-height: 0; }
  .items { width: 100%; border-collapse: collapse; table-layout: fixed; }
  .items thead { display: table-header-group; }
  .items tr { break-inside: avoid; page-break-inside: avoid; }
  .items thead th { font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.1em; color: #fff; font-weight: 700; text-align: left; padding: 12px; background: var(--ink); }
  .items tbody td { padding: 10px 12px; border-top: 1px solid var(--line); vertical-align: top; font-size: 10.5px; }
  .items .c-idx { width: 34px; text-align: center; color: var(--accent); font-weight: 700; }
  .items .c-code { width: 90px; }
  .items .c-unit { width: 50px; text-align: center; color: var(--ink-3); }
  .items .c-qty { text-align: right; width: 80px; font-weight: 600; }
  .items .desc .main { font-weight: 600; overflow-wrap: anywhere; }
  .items .desc .sub { font-size: 9.5px; color: var(--ink-3); margin-top: 2px; font-weight: 400; overflow-wrap: anywhere; }
  .items-section.is-empty .items tbody::after { content: 'Sin bienes consignados'; display: block; padding: 12px; color: var(--ink-3); font-size: 10px; }

  .freight-summary { display: flex; justify-content: flex-end; gap: 12px; padding: 8px 12px; background: #fff; border: 1px solid var(--line); border-top: 0; break-inside: avoid; page-break-inside: avoid; }
  .freight-summary .k { color: var(--ink-3); font-size: 8.5px; text-transform: uppercase; letter-spacing: 0.12em; font-weight: 700; }
  .freight-summary .v { font-size: 11px; font-weight: 700; }

  .related { background: #fff; border: 1px solid var(--line); border-radius: 4px; padding: 12px 16px; margin-top: 14px; display: grid; grid-template-columns: 1fr 1fr; gap: 20px; break-inside: avoid; page-break-inside: avoid; }
  .related .block .head { font-size: 9px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--accent); font-weight: 700; margin-bottom: 4px; }
  .related .block .body { font-size: 10px; }
  .related .block .body p { overflow-wrap: anywhere; }
  .related .small { font-size: 9.5px; color: var(--ink-2); }

  .foot { display: grid; grid-template-columns: 96px 1fr auto; gap: 18px; align-items: start; margin-top: auto; padding-top: 14px; border-top: 2px solid var(--ink); break-inside: avoid; page-break-inside: avoid; }
  .foot .qr { width: 96px; height: 96px; background: #fff; padding: 4px; border-radius: 4px; border: 1.5px solid var(--ink); }
  .foot .qr img { width: 100%; height: 100%; display: block; }
  .foot .meta { font-size: 9.5px; color: var(--ink-2); }
  .foot .meta strong { color: var(--ink); }
  .foot .meta .hash { font-family: 'JetBrains Mono', monospace; word-break: break-all; font-size: 8.5px; margin-top: 4px; color: var(--ink-3); }
  .foot .stamp { text-align: right; min-width: 180px; }
  .foot .stamp .badge { display: inline-block; background: var(--ink); color: var(--accent); padding: 6px 12px; border-radius: 2px; font-size: 9.5px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
  .foot .stamp .line { font-size: 9.5px; color: var(--ink-2); margin-top: 8px; max-width: 190px; }
</style>
</head>
<body>
<div id="gre-source" class="page source-only" aria-hidden="true">
  <div class="page-shell">
    <section data-fragment="full-header">
      <div class="hero">
        <div class="left">
          <div class="mark">
            <div class="logo">{% if params.logo is not empty %}<img src="{{ params.logo }}" alt="logo"/>{% else %}<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="3"><circle cx="20" cy="20" r="14"/><path d="M9 23l5-9 6 4 6-7"/></svg>{% endif %}</div>
            <div>
              <div class="co-name">{% if cp is not null %}{{ cp.razonSocial }}{% endif %}</div>
              <div class="co-tag">{% if cp is not null and cp.nombreComercial is not empty and cp.nombreComercial != cp.razonSocial %}{{ cp.nombreComercial }}{% endif %}{% if params.establishmentName is not empty %}{% if cp is not null and cp.nombreComercial is not empty and cp.nombreComercial != cp.razonSocial %} · {% endif %}{{ params.establishmentName }}{% endif %}</div>
            </div>
          </div>
          <div class="info">
            {% if cp is not null and cp.direccion is not null %}<p class="issuer-address"><span class="issuer-label">Dirección</span>{{ cp.direccion.direccion }}</p><p class="issuer-address"><span class="issuer-label">Ubicación</span>{{ cp.direccion.departamento }}{% if cp.direccion.provincia is not empty %} — {{ cp.direccion.provincia }}{% endif %}{% if cp.direccion.distrito is not empty %} — {{ cp.direccion.distrito }}{% endif %}{% if cp.direccion.ubigeo is not empty %} · {{ cp.direccion.ubigeo }}{% endif %}</p>{% endif %}
            {% if cp is not null and cp.contacto is not null and (cp.contacto.email is not empty or cp.contacto.telefono is not empty) %}<p class="issuer-contact">{% if cp.contacto.email is not empty %}{{ cp.contacto.email }}{% endif %}{% if cp.contacto.email is not empty and cp.contacto.telefono is not empty %} · {% endif %}{% if cp.contacto.telefono is not empty %}{{ cp.contacto.telefono }}{% endif %}</p>{% endif %}
            {% if doc.envio is not null and doc.envio.transportista is not null and doc.envio.transportista.numeroRegistroMTC is not empty %}<p class="issuer-mtc"><span class="issuer-label">Reg. MTC</span><b>{{ doc.envio.transportista.numeroRegistroMTC }}</b></p>{% endif %}
          </div>
        </div>
        <div class="right">
          <div>
            <div class="kind">GUÍA DE REMISIÓN TRANSPORTISTA</div>
            <div class="subkind">GRE-T ELECTRÓNICA</div>
            <div class="num">{{ docNumber }}</div>
            {% if params.estadoPago is not empty %}<div class="row" style="margin-top:8px;"><span class="k">Estado de pago</span><span class="v">{{ params.estadoPago }}</span></div>{% endif %}
            {% if params.trackingNumber is not empty %}<div class="row"><span class="k">Nro. tracking</span><span class="v mono tracking-number">{{ params.trackingNumber }}</span></div>{% endif %}
          </div>
          <div>
            <div class="rule"></div>
            <div class="row"><span class="k">RUC</span><span class="v mono">{% if cp is not null %}{{ cp.ruc }}{% endif %}</span></div>
            <div class="row"><span class="k">Emitido</span><span class="v">{{ doc.fechaEmision|date('d/m/Y') }}{% if doc.horaEmision is not null %} · {{ doc.horaEmision }}{% endif %}</span></div>
            <div class="row"><span class="k">Modalidad</span><span class="v">{% if doc.envio is not null %}{{ doc.envio.tipoModalidadTraslado|catalog('18') }}{% endif %}</span></div>
            <div class="row"><span class="k">Peso · bultos</span><span class="v">{% if doc.envio is not null %}{{ doc.envio.pesoTotal }} {{ doc.envio.pesoTotalUnidadMedida }}{% if doc.envio.numeroDeBultos is not null %} · {{ doc.envio.numeroDeBultos }}{% endif %}{% endif %}</span></div>
          </div>
        </div>
      </div>
    </section>

    <section data-fragment="compact-header">
      <div class="continuation-header">
        <div class="tag">GRE-T · Continuación de bienes transportados</div>
        <div class="ruc">RUC {% if cp is not null %}{{ cp.ruc }}{% endif %}</div>
        <div class="num">{{ docNumber }}</div>
      </div>
    </section>

    <section data-fragment="intro">
      <div class="route">
        <div class="leg">
          <div class="k">Punto de partida</div>
          <div class="v">{% if doc.envio is not null and doc.envio.partida is not null %}{{ doc.envio.partida.direccion }}{% endif %}</div>
          <div class="a">{% if params.partidaDistrito is not empty %}{% if params.partidaDepartamento is not empty %}{{ params.partidaDepartamento }} — {{ params.partidaProvincia }} — {% endif %}{{ params.partidaDistrito }}{% endif %}{% if doc.envio is not null and doc.envio.partida is not null and doc.envio.partida.ubigeo is not empty %} · {{ doc.envio.partida.ubigeo }}{% endif %}</div>
        </div>
        <div class="arrow">→</div>
        <div class="leg right">
          <div class="k">Punto de llegada</div>
          <div class="v">{% if doc.envio is not null and doc.envio.destino is not null %}{{ doc.envio.destino.direccion }}{% endif %}</div>
          <div class="a">{% if params.destinoDistrito is not empty %}{% if params.destinoDepartamento is not empty %}{{ params.destinoDepartamento }} — {{ params.destinoProvincia }} — {% endif %}{{ params.destinoDistrito }}{% endif %}{% if doc.envio is not null and doc.envio.destino is not null and doc.envio.destino.ubigeo is not empty %} · {{ doc.envio.destino.ubigeo }}{% endif %}</div>
        </div>
      </div>
    </section>

    <section data-fragment="intro">
      <div class="strip">
        <div class="chip"><span class="k">Inicio traslado</span><span class="v">{% if doc.envio is not null and doc.envio.fechaTraslado is not null %}{{ doc.envio.fechaTraslado|date('d/m/Y') }}{% endif %}</span></div>
        <div class="chip"><span class="k">Motivo</span><span class="v">{% if doc.envio is not null %}{{ doc.envio.motivoTraslado }}{% endif %}</span></div>
        <div class="chip"><span class="k">Estado GRE-T</span><span class="v">{{ params.estadoGreT|default('GRE-T PENDIENTE') }}</span></div>
        <div class="chip"><span class="k">Inicio traslado</span><span class="v">{% if doc.envio is not null and doc.envio.fechaTraslado is not null %}{{ doc.envio.fechaTraslado|date('d/m/Y') }}{% endif %}</span></div>
      </div>
    </section>

    <section data-fragment="intro">
      <div class="parties">
        <div class="party">
          <div class="label">Remitente</div>
          {% if tercero is not null %}
          <div class="name">{{ tercero.nombre }}</div>
          <div class="row"><span class="k">{{ tercero.tipoDocumentoIdentidad|catalogAttr('06','abreviatura') }}</span><span class="mono">{{ tercero.numeroDocumentoIdentidad }}</span></div>
          {% endif %}
        </div>
        <div class="party">
          <div class="label">Destinatario</div>
          {% if cl is not null %}
          <div class="name">{{ cl.nombre }}</div>
          <div class="row"><span class="k">{{ cl.tipoDocumentoIdentidad|catalogAttr('06','abreviatura') }}</span><span class="mono">{{ cl.numeroDocumentoIdentidad }}</span></div>
          {% endif %}
        </div>
      </div>
    </section>

    {% if hasIndicadoresTraslado %}
    <section data-fragment="intro">
      <div class="stack"><div class="party"><div class="label">Indicadores de traslado</div><div class="pill-list">{% for indicador in indicadoresTraslado %}<span class="pill">{{ indicador }}</span>{% endfor %}</div></div></div>
    </section>
    {% endif %}

    {% if hasSubcontratacion %}
    <section data-fragment="intro">
      <div class="stack">
        <div class="party">
          <div class="label">Subcontrataciones del traslado</div>
          <div class="subgrid">
            {% if hasSubcontratante %}
            <div>
              <div class="name">Subcontratación SUNAT · Contratante del transporte</div>
              <div class="subcontract-fields">
                {% if doc.subcontratado.nombre is not empty %}<div class="subcontract-field"><span class="k">Nombre</span><span class="v">{{ doc.subcontratado.nombre }}</span></div>{% endif %}
                {% if doc.subcontratado.numeroDocumentoIdentidad is not empty %}<div class="subcontract-field"><span class="k">RUC</span><span class="v mono">{{ doc.subcontratado.numeroDocumentoIdentidad }}</span></div>{% endif %}
                {% if doc.subcontratado.numeroRegistroMTC is not empty %}<div class="subcontract-field"><span class="k">REG. MTC</span><span class="v mono">{{ doc.subcontratado.numeroRegistroMTC }}</span></div>{% endif %}
              </div>
            </div>
            {% endif %}
            {% if hasSubcontratista %}
            <div>
              <div class="name">Subcontratación interna · Proveedor subcontratado</div>
              <div class="subcontract-fields">
                {% if params.subcontratistaNombre is not empty %}<div class="subcontract-field"><span class="k">Nombre</span><span class="v">{{ params.subcontratistaNombre }}</span></div>{% endif %}
                {% if params.subcontratistaRuc is not empty %}<div class="subcontract-field"><span class="k">RUC</span><span class="v mono">{{ params.subcontratistaRuc }}</span></div>{% endif %}
                {% if params.subcontratistaMtc is not empty %}<div class="subcontract-field"><span class="k">REG. MTC</span><span class="v mono">{{ params.subcontratistaMtc }}</span></div>{% endif %}
              </div>
            </div>
            {% endif %}
          </div>
        </div>
      </div>
    </section>
    {% endif %}

    <section data-fragment="intro">
      <div class="transport">
        <div class="card">
          <div class="head"><div class="icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 17V7h13l5 5v5M3 17h2M9 17h10M5 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zm14 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/></svg></div><div class="title">Vehículos</div></div>
          {% if doc.envio is not null and doc.envio.vehiculo is not null %}
          {% set vp = doc.envio.vehiculo %}
          <div class="veh"><div class="veh-label">Principal</div><div class="vehicle-fields"><div class="vehicle-field"><span class="k">Placa</span><span class="v mono">{{ vp.placa }}</span></div>{% if vp.numeroCirculacion is not empty %}<div class="vehicle-field"><span class="k">TUC/CHV</span><span class="v mono">{{ vp.numeroCirculacion }}</span></div>{% endif %}{% if vp.marca is not empty %}<div class="vehicle-field"><span class="k">Marca</span><span class="v">{{ vp.marca }}</span></div>{% endif %}{% if vp.modelo is not empty %}<div class="vehicle-field"><span class="k">Modelo</span><span class="v">{{ vp.modelo }}</span></div>{% endif %}{% if vp.numeroAutorizacion is not empty %}<div class="vehicle-field"><span class="k">Autorización</span><span class="v mono">{{ vp.numeroAutorizacion }}</span></div>{% endif %}</div></div>
          {% if vp.secundarios is not empty %}{% for v in vp.secundarios %}<div class="veh"><div class="veh-label">Secundaria</div><div class="vehicle-fields"><div class="vehicle-field"><span class="k">Placa</span><span class="v mono">{{ v.placa }}</span></div>{% if v.numeroCirculacion is not empty %}<div class="vehicle-field"><span class="k">TUC/CHV</span><span class="v mono">{{ v.numeroCirculacion }}</span></div>{% endif %}{% if v.marca is not empty %}<div class="vehicle-field"><span class="k">Marca</span><span class="v">{{ v.marca }}</span></div>{% endif %}{% if v.modelo is not empty %}<div class="vehicle-field"><span class="k">Modelo</span><span class="v">{{ v.modelo }}</span></div>{% endif %}{% if v.numeroAutorizacion is not empty %}<div class="vehicle-field"><span class="k">Autorización</span><span class="v mono">{{ v.numeroAutorizacion }}</span></div>{% endif %}</div></div>{% endfor %}{% endif %}
          {% endif %}
        </div>
        <div class="card">
          <div class="head"><div class="icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a8 8 0 0 1 16 0v1"/></svg></div><div class="title">Conductores</div></div>
          {% if doc.envio is not null and doc.envio.choferes is not empty %}{% for ch in doc.envio.choferes %}
          <div class="row"><span class="k">{% if loop.first %}Principal{% else %}Secundario{% endif %}</span><span>{{ ch.nombres }} {{ ch.apellidos }}</span></div>
          <div class="row"><span class="k">{{ ch.tipoDocumentoIdentidad|catalogAttr('06','abreviatura') }} · Brevete</span><span class="mono">{{ ch.numeroDocumentoIdentidad }}{% if ch.licencia is not empty %} · {{ ch.licencia }}{% endif %}</span></div>
          {% endfor %}{% endif %}
        </div>
      </div>
    </section>

    <div class="items-card" data-fragment="items-head">
      <table class="items">
        <thead>
          <tr><th class="c-idx">#</th><th class="c-code">Código</th><th>Descripción del bien</th><th class="c-unit">Und</th><th class="c-qty">Cant.</th></tr>
        </thead>
      </table>
    </div>

    {% for det in doc.detalles %}
    <template data-fragment="item-row">
    <tr>
      <td class="c-idx mono">{{ (loop.index + 1)|str_pad(2, '0', 'left') }}</td>
      <td class="c-code mono">{{ det.codigo }}</td>
      <td class="desc"><div class="main">{{ det.descripcion }}</div>{% if det.codigoSunat is not empty %}<div class="sub">SUNAT {{ det.codigoSunat }}</div>{% endif %}</td>
      <td class="c-unit">{{ det.unidadMedida }}</td>
      <td class="c-qty mono">{{ det.cantidad|q_format }}</td>
    </tr>
    </template>
    {% endfor %}

    {% if params.totalGuia is not null %}<div class="freight-summary" data-fragment="closing"><span class="k">Flete</span><span class="v">S/ {{ params.totalGuia|n_format }}</span></div>{% endif %}

    {% if hasClosing %}
    <div class="related" data-fragment="closing">
      {% if doc.documentosRelacionados is not empty %}
      <div class="block"><div class="head">Documentos relacionados</div><div class="body">{% for rel in doc.documentosRelacionados %}<p>{{ rel.tipoDocumento }} · <span class="mono">{{ rel.serieNumero }}</span></p>{% endfor %}</div></div>
      {% endif %}
      {% if doc.observaciones is not empty %}
      <div class="block"><div class="head">Observaciones</div><div class="body">{% for obs in doc.observaciones|split('\n') %}<p class="small">· {{ obs }}</p>{% endfor %}</div></div>
      {% endif %}
    </div>
    {% endif %}

    <div class="foot" data-fragment="closing">
      <div class="qr">{% if qrBase64 is not empty %}<img src="data:image/png;base64,{{ qrBase64 }}" alt="QR Code" />{% endif %}</div>
      <div class="meta">
        <p><strong>Representación impresa</strong> de la Guía de Remisión Transportista Electrónica.</p>
        <p>Consulte la validez en <strong>{{ params.consultaUrl|default('sunat.gob.pe') }}</strong> con el RUC del transportista y el número del documento.</p>
        <p style="margin-top:6px;">Firmante: {% if cp is not null %}{{ cp.ruc }} · {{ cp.razonSocial }}{% endif %}</p>
        {% if hashDocumento is not empty %}<p class="hash">Hash: {{ hashDocumento }}</p>{% endif %}
        {% if params.footer is not null %}<p id="custom-footer-box" style="margin-top:10px; font-style:italic;">{{ params.footer }}</p>{% endif %}
      </div>
      <div class="stamp">
        <span class="badge">{{ params.estadoGreT|default('GRE-T PENDIENTE') }}</span>
        <div class="line">Documento electrónico emitido conforme a la RS SUNAT 271-2019.</div>
      </div>
    </div>
  </div>
</div>

<div id="gre-pages"></div>

<script>
window.__ublkitRenderReady = false;
(async function () {
  const source = document.getElementById('gre-source');
  const root = document.getElementById('gre-pages');
  if (!source || !root) {
    window.__ublkitRenderReady = true;
    return;
  }
  if (document.fonts && document.fonts.ready) {
    await document.fonts.ready;
  }
  await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));

  const fullHeader = source.querySelector('[data-fragment="full-header"]');
  const compactHeader = source.querySelector('[data-fragment="compact-header"]');
  const introBlocks = Array.from(source.querySelectorAll('[data-fragment="intro"]'));
  const itemsHead = source.querySelector('[data-fragment="items-head"] .items thead');
  const itemRows = Array.from(source.querySelectorAll('template[data-fragment="item-row"]'));
  const closingBlocks = Array.from(source.querySelectorAll('[data-fragment="closing"]'));

  function createPage(firstPage) {
    const page = document.createElement('section');
    page.className = 'page' + (firstPage ? ' first-page' : ' continuation-page');
    const shell = document.createElement('div');
    shell.className = 'page-shell';
    page.appendChild(shell);
    shell.appendChild((firstPage ? fullHeader : compactHeader).cloneNode(true));
    if (firstPage) {
      introBlocks.forEach(block => shell.appendChild(block.cloneNode(true)));
    }
    const itemsSection = document.createElement('section');
    itemsSection.className = 'items-section';
    const itemsCard = document.createElement('div');
    itemsCard.className = 'items-card';
    const table = document.createElement('table');
    table.className = 'items';
    table.appendChild(itemsHead.cloneNode(true));
    const tbody = document.createElement('tbody');
    table.appendChild(tbody);
    itemsCard.appendChild(table);
    itemsSection.appendChild(itemsCard);
    shell.appendChild(itemsSection);
    root.appendChild(page);
    return { shell, itemsSection, tbody };
  }

  function overflows(state) {
    return state.shell.scrollHeight > (state.shell.clientHeight + 1);
  }

  let current = createPage(true);
  itemRows.forEach(row => {
    const clone = row.content.firstElementChild.cloneNode(true);
    current.tbody.appendChild(clone);
    if (overflows(current)) {
      current.tbody.removeChild(clone);
      current = createPage(false);
      current.tbody.appendChild(clone);
    }
  });

  root.querySelectorAll('.items-section').forEach(section => {
    if (!section.querySelector('tbody').children.length) {
      section.classList.add('is-empty');
    }
  });

  if (closingBlocks.length) {
    const nodes = closingBlocks.map(block => block.cloneNode(true));
    nodes.forEach(node => current.shell.appendChild(node));
    if (overflows(current)) {
      nodes.forEach(node => current.shell.removeChild(node));
      current = createPage(false);
      if (!current.tbody.children.length) {
        current.itemsSection.classList.add('is-empty');
      }
      nodes.forEach(node => current.shell.appendChild(node));
    }
  }

  source.remove();
  window.__ublkitRenderReady = true;
})();
</script>
</body>
</html>
