<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
{% set cp = doc.remitente %}
{% set tercero = doc.tercero %}
{% set cl = doc.destinatario %}
{% set name = doc.tipoComprobante|catalog('01') %}
{% set docNumber = doc.serie ~ '-' ~ (doc.numero|str_pad(8, '0', 'left')) %}
{% set hasSubcontratante = doc.subcontratado is not null and (doc.subcontratado.nombre is not empty or doc.subcontratado.numeroDocumentoIdentidad is not empty or doc.subcontratado.numeroRegistroMTC is not empty) %}
{% set hasSubcontratista = params.subcontratistaNombre is not empty or params.subcontratistaRuc is not empty or params.subcontratistaMtc is not empty %}
{% set hasSubcontratacion = hasSubcontratante or hasSubcontratista %}
{% set hasIndicadoresTraslado = indicadoresTraslado is defined and indicadoresTraslado is not empty %}
{% set hasClosing = doc.documentosRelacionados is not empty or doc.observaciones is not empty %}
<title>{{ docNumber }} · {{ name }}</title>
<style>
  {{ fontStyle | raw }}
  @page { size: A4 portrait; margin: 0; }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: #fff; }
  :root {
    --page-width: 794px;
    --page-height: 1123px;
    --ink: #0a0a0a;
    --ink-2: #737373;
    --ink-3: #a3a3a3;
    --line: #e5e5e5;
    --paper: #fff;
  }
  body {
    font-family: 'Inter', sans-serif;
    font-size: 10.5px;
    line-height: 1.45;
    color: var(--ink);
    background: var(--paper);
    width: var(--page-width);
    margin: 0 auto;
  }
  .mono { font-family: 'IBM Plex Mono', monospace; font-variant-numeric: tabular-nums; }
  h1, h2, h3 { margin: 0; font-weight: 600; }
  p, dl, dt, dd { margin: 0; }

  .page {
    width: var(--page-width);
    height: var(--page-height);
    min-height: var(--page-height);
    padding: 32px 36px;
    background: var(--paper);
    overflow: hidden;
    break-after: page;
    page-break-after: always;
  }
  .page:last-child { break-after: auto; page-break-after: auto; }
  .page-shell { height: 100%; display: flex; flex-direction: column; min-height: 0; }
  .source-only {
    position: fixed;
    top: 0;
    left: -200vw;
    width: var(--page-width);
    visibility: hidden;
    pointer-events: none;
  }

  .masthead { display: grid; grid-template-columns: 1fr auto; align-items: start; gap: 28px; padding-bottom: 15px; border-bottom: 1.5px solid var(--ink); }
  .brand .mark { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .brand .mark .logo { width: 52px; height: 52px; color: var(--ink); object-fit: contain; }
  .brand .mark .name { font-size: 12.5px; font-weight: 600; }
  .brand .meta { display: grid; grid-template-columns: 104px minmax(0, 1fr); column-gap: 14px; row-gap: 3px; font-size: 10px; }
  .brand .meta dt { text-transform: uppercase; letter-spacing: .07em; font-size: 9px; color: var(--ink-2); }
  .brand .meta dd { color: var(--ink); overflow-wrap: anywhere; }
  .issuer-contact, .issuer-address, .issuer-location { overflow-wrap: anywhere; }

  .doc-id { text-align: right; min-width: 248px; }
  .doc-id .ruc { font-size: 10px; color: var(--ink-2); text-transform: uppercase; letter-spacing: 0.1em; }
  .doc-id .ruc strong { color: var(--ink); font-family: 'IBM Plex Mono', monospace; letter-spacing: 0.02em; }
  .doc-id .kind { font-size: 16px; font-weight: 600; letter-spacing: .025em; margin-top: 2px; line-height: 1.15; }
  .doc-id .sub { font-size: 10px; color: #525252; text-transform: uppercase; letter-spacing: 0.1em; }
  .doc-id .num { font-family: 'IBM Plex Mono', monospace; font-size: 19px; font-weight: 600; margin-top: 4px; letter-spacing: 0.04em; }
  .doc-id .aux { margin-top: 5px; font-size: 10px; color: #404040; }
  .doc-id .aux .label { color: var(--ink-2); text-transform: uppercase; letter-spacing: .07em; font-size: 9px; margin-right: 6px; }
  .doc-id .issued { margin-top: 5px; font-size: 10px; color: #404040; }
  .tracking-number { font-size: 10px !important; font-weight: 500 !important; letter-spacing: 0.02em; }

  .continuation-header {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: end;
    gap: 16px;
    padding-bottom: 12px;
    border-bottom: 1.5px solid var(--ink);
    margin-bottom: 16px;
  }
  .continuation-header .tag { font-size: 10px; text-transform: uppercase; letter-spacing: .11em; color: var(--ink-2); }
  .continuation-header .ruc { font-size: 10px; text-transform: uppercase; letter-spacing: .07em; color: var(--ink-2); }
  .continuation-header .num { font-size: 17px; font-weight: 600; letter-spacing: .04em; font-family: 'IBM Plex Mono', monospace; }

  .route { display: grid; grid-template-columns: 1fr 28px 1fr; gap: 16px; align-items: center; padding: 15px 0; border-bottom: 1px solid var(--ink); }
  .route .leg .k { font-size: 9px; text-transform: uppercase; letter-spacing: .07em; color: var(--ink-2); }
  .route .leg .v { font-size: 12px; font-weight: 600; margin-top: 2px; overflow-wrap: anywhere; }
  .route .leg .a { font-size: 10px; color: #525252; margin-top: 2px; overflow-wrap: anywhere; }
  .route .arrow { text-align: center; font-size: 20px; color: var(--ink); }
  .route .leg.right { text-align: right; }

  .parties { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; padding: 15px 0; border-bottom: 1px solid var(--ink); }
  .party .label { font-size: 9px; text-transform: uppercase; letter-spacing: .07em; color: var(--ink-2); margin-bottom: 6px; }
  .party .name { font-size: 11.5px; font-weight: 600; margin-bottom: 4px; overflow-wrap: anywhere; }
  .party .row { display: flex; gap: 12px; font-size: 10px; line-height: 1.35; margin-top: 2px; min-width: 0; }
  .party .row span:first-child { flex: 0 0 80px; min-width: 80px; color: var(--ink-2); text-transform: uppercase; letter-spacing: .045em; font-size: 9px; }
  .party .row span:last-child { min-width: 0; overflow-wrap: anywhere; }

  .strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(128px, 1fr)); gap: 8px 20px; padding: 8px 0; border-bottom: 1px solid var(--ink); font-size: 10px; }
  .strip > div .k { display: block; font-size: 9px; color: var(--ink-2); text-transform: uppercase; letter-spacing: .07em; margin-bottom: 2px; }
  .strip > div .v { color: var(--ink); font-weight: 500; overflow-wrap: anywhere; }

  .stack-card {
    padding: 14px 0;
    border-bottom: 1px solid var(--ink);
    break-inside: avoid;
    page-break-inside: avoid;
  }
  .stack-card .head { font-size: 9px; text-transform: uppercase; letter-spacing: .07em; color: var(--ink-2); margin-bottom: 6px; }
  .stack-card .name { font-size: 11.5px; font-weight: 600; margin-bottom: 4px; overflow-wrap: anywhere; }
  .indicator-list { display: flex; flex-wrap: wrap; gap: 8px; }
  .indicator { border: 1px solid var(--ink); padding: 4px 8px; font-size: 9.5px; }
  .subcontract-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 18px; }
  .subcontract-fields { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .subcontract-field .k { display: block; color: var(--ink-2); text-transform: uppercase; letter-spacing: .045em; font-size: 9px; }
  .subcontract-field .v { display: block; margin-top: 2px; font-size: 10px; overflow-wrap: anywhere; }

  .transport-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    padding: 15px 0;
    border-bottom: 1px solid var(--ink);
    break-inside: avoid;
    page-break-inside: avoid;
  }
  .transport-grid .block .head { font-size: 9px; text-transform: uppercase; letter-spacing: .07em; color: var(--ink-2); margin-bottom: 6px; }
  .transport-grid .block .row { display: flex; gap: 12px; font-size: 10px; line-height: 1.35; margin-top: 2px; }
  .transport-grid .block .row span:first-child { flex: 0 0 80px; min-width: 80px; color: var(--ink-2); text-transform: uppercase; letter-spacing: .045em; font-size: 9px; }
  .transport-grid .block .row span:last-child { min-width: 0; overflow-wrap: anywhere; }
  .vehicle-entry { padding: 3px 0; }
  .vehicle-entry + .vehicle-entry { margin-top: 4px; padding-top: 6px; border-top: 1px dashed #d4d4d4; }
  .vehicle-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 5px 12px; }
  .vehicle-field { display: flex; align-items: baseline; gap: 4px; min-width: 0; white-space: nowrap; }
  .vehicle-field .k { display: inline; flex: 0 0 auto; color: var(--ink-2); text-transform: uppercase; letter-spacing: .045em; font-size: 9px; }
  .vehicle-field .v { display: inline; min-width: 0; margin-top: 0; font-size: 10px; overflow-wrap: anywhere; white-space: normal; }

  .items-section {
    margin-top: 14px;
    display: flex;
    flex-direction: column;
    min-height: 0;
    break-inside: avoid;
    page-break-inside: avoid;
  }
  .items-card { display: flex; flex-direction: column; min-height: 0; }
  .items { width: 100%; border-collapse: collapse; table-layout: fixed; }
  .items thead { display: table-header-group; }
  .items tr { break-inside: avoid; page-break-inside: avoid; }
  .items thead th { font-size: 9px; text-transform: uppercase; letter-spacing: .07em; color: var(--ink-2); font-weight: 500; text-align: left; padding: 0 8px 7px 0; border-bottom: 1px solid var(--ink); }
  .items tbody td { padding: 9px 8px 9px 0; border-bottom: 1px dashed var(--line); vertical-align: top; font-size: 10.5px; }
  .items .c-idx { width: 24px; color: var(--ink-3); }
  .items .c-code { width: 84px; }
  .items .c-unit { width: 50px; text-align: center; color: var(--ink-2); }
  .items .c-qty { width: 70px; text-align: right; padding-right: 0; }
  .items .desc .main { font-weight: 600; overflow-wrap: anywhere; }
  .items .desc .sub { font-size: 9.5px; color: var(--ink-2); margin-top: 3px; line-height: 1.3; overflow-wrap: anywhere; }
  .items-section.is-empty .items tbody::after {
    content: 'Sin bienes consignados';
    display: block;
    padding: 12px 0;
    color: var(--ink-2);
    font-size: 10px;
  }

  .freight-summary { display: flex; justify-content: flex-end; gap: 12px; padding: 8px 0 0; font-size: 10px; }
  .freight-summary .k { color: var(--ink-2); text-transform: uppercase; letter-spacing: .07em; font-size: 9px; }
  .freight-summary .v { font-weight: 600; }

  .related {
    margin-top: 16px;
    padding: 12px 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    break-inside: avoid;
    page-break-inside: avoid;
  }
  .related .block .head { font-size: 9px; text-transform: uppercase; letter-spacing: .07em; color: var(--ink-2); margin-bottom: 5px; }
  .related .block .body { font-size: 10px; }
  .related .block .body p { padding: 1px 0; overflow-wrap: anywhere; }
  .related .small { font-size: 9.5px; color: #525252; }

  .foot {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr) 152px;
    gap: 15px;
    align-items: start;
    margin-top: auto;
    padding-top: 13px;
    border-top: 1.5px solid var(--ink);
    break-inside: avoid;
    page-break-inside: avoid;
  }
  .foot .qr { width: 112px; height: 112px; padding: 0; aspect-ratio: 1 / 1; }
  .foot .qr { border: 1px solid var(--ink); }
  .foot .qr img, .foot .qr svg { width: 100%; height: 100%; display: block; object-fit: contain; }
  .foot .qr img { image-rendering: pixelated; }
  .foot .meta { line-height: 1.4; font-size: 9.5px; color: #525252; }
  .foot .meta strong { color: var(--ink); }
  .foot .meta p + p { margin-top: 4px; }
  .foot .meta .hash { font-size: 8.5px; line-height: 1.35; overflow-wrap: anywhere; margin-top: 2px; font-family: 'IBM Plex Mono', monospace; }
  .foot .stamp { text-align: center; align-self: center; padding-top: 2px; }
  .foot .stamp .badge { display: inline-block; border: 1px solid var(--ink); padding: 3px 8px; font-size: 9px; text-transform: uppercase; letter-spacing: .08em; }
  .foot .stamp .line { margin: 5px auto 0; max-width: 150px; line-height: 1.35; font-size: 9.5px; color: #525252; }

  /* Classic Mono refinement: precise hierarchy, compact metadata and stable tables. */
</style>
</head>
<body>
<div id="gre-source" class="page source-only" aria-hidden="true">
  <div class="page-shell">
    <section data-fragment="full-header">
      <div class="masthead">
        <div class="brand">
          <div class="mark">
            {% if params.logo is not empty %}<img class="logo" src="{{ params.logo }}" alt="logo"/>{% else %}<svg class="logo" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="20" cy="20" r="14"/><path d="M9 23l5-9 6 4 6-7"/></svg>{% endif %}
            <div class="name">{% if cp is not null %}{{ cp.razonSocial }}{% endif %}</div>
          </div>
          <dl class="meta">
            {% if cp is not null and cp.direccion is not null %}
            <dt>Dirección</dt><dd class="issuer-address">{{ cp.direccion.direccion }}</dd>
            <dt>Ubicación</dt><dd class="issuer-location">{{ cp.direccion.departamento }}{% if cp.direccion.provincia is not empty %} — {{ cp.direccion.provincia }}{% endif %}{% if cp.direccion.distrito is not empty %} — {{ cp.direccion.distrito }}{% endif %}{% if cp.direccion.ubigeo is not empty %} · {{ cp.direccion.ubigeo }}{% endif %}</dd>
            {% endif %}
            {% if params.establishmentName is not empty %}<dt>Establecimiento</dt><dd>{{ params.establishmentName }}</dd>{% endif %}
            {% if cp is not null and cp.contacto is not null and (cp.contacto.email is not empty or cp.contacto.telefono is not empty) %}<dt>Contacto</dt><dd class="issuer-contact">{% if cp.contacto.email is not empty %}{{ cp.contacto.email }}{% endif %}{% if cp.contacto.email is not empty and cp.contacto.telefono is not empty %} · {% endif %}{% if cp.contacto.telefono is not empty %}{{ cp.contacto.telefono }}{% endif %}</dd>{% endif %}
            {% if doc.envio is not null and doc.envio.transportista is not null and doc.envio.transportista.numeroRegistroMTC is not empty %}<dt>Reg. MTC</dt><dd class="issuer-mtc mono">{{ doc.envio.transportista.numeroRegistroMTC }}</dd>{% endif %}
          </dl>
        </div>
        <div class="doc-id">
          <div class="ruc">RUC <strong>{% if cp is not null %}{{ cp.ruc }}{% endif %}</strong></div>
          <div class="kind">GUÍA DE REMISIÓN TRANSPORTISTA</div>
          <div class="sub">GRE-T ELECTRÓNICA</div>
          <div class="num">{{ docNumber }}</div>
          {% if params.estadoPago is not empty %}<div class="aux"><span class="label">Estado de pago</span>{{ params.estadoPago }}</div>{% endif %}
          {% if params.trackingNumber is not empty %}<div class="aux tracking-number"><span class="label">Nro. tracking</span><span class="mono">{{ params.trackingNumber }}</span></div>{% endif %}
          <div class="issued">Emitido {{ doc.fechaEmision|date('d/m/Y') }}{% if doc.horaEmision is not null %} · {{ doc.horaEmision }}{% endif %}</div>
        </div>
      </div>
    </section>

    <section data-fragment="compact-header">
      <div class="continuation-header">
        <div class="tag">GRE-T · Continuación de bienes transportados</div>
        <div class="ruc">RUC {% if cp is not null %}{{ cp.ruc }}{% endif %}</div>
        <div class="num">{{ docNumber }}</div>
      </div>
    </section>

    <section data-fragment="intro">
      <div class="route">
        <div class="leg">
          <div class="k">Punto de partida</div>
          <div class="v">{% if doc.envio is not null and doc.envio.partida is not null %}{{ doc.envio.partida.direccion }}{% endif %}</div>
          <div class="a">{% if params.partidaDistrito is not empty %}{% if params.partidaDepartamento is not empty %}{{ params.partidaDepartamento }} — {{ params.partidaProvincia }} — {% endif %}{{ params.partidaDistrito }}{% endif %}{% if doc.envio is not null and doc.envio.partida is not null and doc.envio.partida.ubigeo is not empty %} · {{ doc.envio.partida.ubigeo }}{% endif %}</div>
        </div>
        <div class="arrow">→</div>
        <div class="leg right">
          <div class="k">Punto de llegada</div>
          <div class="v">{% if doc.envio is not null and doc.envio.destino is not null %}{{ doc.envio.destino.direccion }}{% endif %}</div>
          <div class="a">{% if params.destinoDistrito is not empty %}{% if params.destinoDepartamento is not empty %}{{ params.destinoDepartamento }} — {{ params.destinoProvincia }} — {% endif %}{{ params.destinoDistrito }}{% endif %}{% if doc.envio is not null and doc.envio.destino is not null and doc.envio.destino.ubigeo is not empty %} · {{ doc.envio.destino.ubigeo }}{% endif %}</div>
        </div>
      </div>
    </section>

    <section data-fragment="intro">
      <div class="parties">
        <div class="party">
          <div class="label">Remitente</div>
          {% if tercero is not null %}
          <div class="name">{{ tercero.nombre }}</div>
          <div class="row"><span>{{ tercero.tipoDocumentoIdentidad|catalogAttr('06','abreviatura') }}</span><span class="mono">{{ tercero.numeroDocumentoIdentidad }}</span></div>
          {% endif %}
        </div>
        <div class="party">
          <div class="label">Destinatario</div>
          {% if cl is not null %}
          <div class="name">{{ cl.nombre }}</div>
          <div class="row"><span>{{ cl.tipoDocumentoIdentidad|catalogAttr('06','abreviatura') }}</span><span class="mono">{{ cl.numeroDocumentoIdentidad }}</span></div>
          {% endif %}
        </div>
      </div>
    </section>

    <section data-fragment="intro">
      <div class="strip">
        <div><span class="k">Motivo de traslado</span><span class="v">{% if doc.envio is not null %}{{ doc.envio.motivoTraslado }}{% endif %}</span></div>
        <div><span class="k">Inicio traslado</span><span class="v">{% if doc.envio is not null and doc.envio.fechaTraslado is not null %}{{ doc.envio.fechaTraslado|date('d/m/Y') }}{% endif %}</span></div>
        <div><span class="k">Modalidad</span><span class="v">{% if doc.envio is not null %}{{ doc.envio.tipoModalidadTraslado|catalog('18') }}{% endif %}</span></div>
        <div><span class="k">Peso bruto</span><span class="v">{% if doc.envio is not null %}{{ doc.envio.pesoTotal }} {{ doc.envio.pesoTotalUnidadMedida }}{% endif %}</span></div>
        <div><span class="k">Bultos</span><span class="v">{% if doc.envio is not null and doc.envio.numeroDeBultos is not null %}{{ doc.envio.numeroDeBultos }}{% endif %}</span></div>
      </div>
    </section>

    {% if hasIndicadoresTraslado %}
    <section data-fragment="intro">
      <div class="stack-card">
        <div class="head">Indicadores de traslado</div>
        <div class="indicator-list">
          {% for indicador in indicadoresTraslado %}
          <span class="indicator">{{ indicador }}</span>
          {% endfor %}
        </div>
      </div>
    </section>
    {% endif %}

    {% if hasSubcontratacion %}
    <section data-fragment="intro">
      <div class="stack-card">
        <div class="head">Subcontrataciones del traslado</div>
        <div class="subcontract-grid">
          {% if hasSubcontratante %}
          <div>
            <div class="name">Subcontratación SUNAT · Contratante del transporte</div>
            <div class="subcontract-fields">
              {% if doc.subcontratado.nombre is not empty %}<div class="subcontract-field"><span class="k">Nombre</span><span class="v">{{ doc.subcontratado.nombre }}</span></div>{% endif %}
              {% if doc.subcontratado.numeroDocumentoIdentidad is not empty %}<div class="subcontract-field"><span class="k">RUC</span><span class="v mono">{{ doc.subcontratado.numeroDocumentoIdentidad }}</span></div>{% endif %}
              {% if doc.subcontratado.numeroRegistroMTC is not empty %}<div class="subcontract-field"><span class="k">REG. MTC</span><span class="v mono">{{ doc.subcontratado.numeroRegistroMTC }}</span></div>{% endif %}
            </div>
          </div>
          {% endif %}
          {% if hasSubcontratista %}
          <div>
            <div class="name">Subcontratación interna · Proveedor subcontratado</div>
            <div class="subcontract-fields">
              {% if params.subcontratistaNombre is not empty %}<div class="subcontract-field"><span class="k">Nombre</span><span class="v">{{ params.subcontratistaNombre }}</span></div>{% endif %}
              {% if params.subcontratistaRuc is not empty %}<div class="subcontract-field"><span class="k">RUC</span><span class="v mono">{{ params.subcontratistaRuc }}</span></div>{% endif %}
              {% if params.subcontratistaMtc is not empty %}<div class="subcontract-field"><span class="k">REG. MTC</span><span class="v mono">{{ params.subcontratistaMtc }}</span></div>{% endif %}
            </div>
          </div>
          {% endif %}
        </div>
      </div>
    </section>
    {% endif %}

    <section data-fragment="intro">
      <div class="transport-grid">
        <div class="block">
          <div class="head">Vehículos</div>
          {% if doc.envio is not null and doc.envio.vehiculo is not null %}
          {% set vp = doc.envio.vehiculo %}
          <div class="vehicle-entry">
            <div class="vehicle-fields">
              <div class="vehicle-field"><span class="k">Placa</span><span class="v mono">{{ vp.placa }}</span></div>
              {% if vp.numeroCirculacion is not empty %}<div class="vehicle-field"><span class="k">TUC/CHV</span><span class="v mono">{{ vp.numeroCirculacion }}</span></div>{% endif %}
              {% if vp.marca is not empty %}<div class="vehicle-field"><span class="k">Marca</span><span class="v">{{ vp.marca }}</span></div>{% endif %}
              {% if vp.modelo is not empty %}<div class="vehicle-field"><span class="k">Modelo</span><span class="v">{{ vp.modelo }}</span></div>{% endif %}
              {% if vp.numeroAutorizacion is not empty %}<div class="vehicle-field"><span class="k">Autorización</span><span class="v mono">{{ vp.numeroAutorizacion }}</span></div>{% endif %}
            </div>
          </div>
          {% if vp.secundarios is not empty %}{% for v in vp.secundarios %}
          <div class="vehicle-entry">
            <div class="vehicle-fields">
              <div class="vehicle-field"><span class="k">Placa secundaria</span><span class="v mono">{{ v.placa }}</span></div>
              {% if v.numeroCirculacion is not empty %}<div class="vehicle-field"><span class="k">TUC/CHV</span><span class="v mono">{{ v.numeroCirculacion }}</span></div>{% endif %}
              {% if v.marca is not empty %}<div class="vehicle-field"><span class="k">Marca</span><span class="v">{{ v.marca }}</span></div>{% endif %}
              {% if v.modelo is not empty %}<div class="vehicle-field"><span class="k">Modelo</span><span class="v">{{ v.modelo }}</span></div>{% endif %}
              {% if v.numeroAutorizacion is not empty %}<div class="vehicle-field"><span class="k">Autorización</span><span class="v mono">{{ v.numeroAutorizacion }}</span></div>{% endif %}
            </div>
          </div>
          {% endfor %}{% endif %}
          {% endif %}
        </div>
        <div class="block">
          <div class="head">Conductores</div>
          {% if doc.envio is not null and doc.envio.choferes is not empty %}{% for ch in doc.envio.choferes %}
          <div class="row"><span>{% if loop.first %}Principal{% else %}Secundario{% endif %}</span><span>{{ ch.nombres }} {{ ch.apellidos }}</span></div>
          <div class="row"><span>{{ ch.tipoDocumentoIdentidad|catalogAttr('06','abreviatura') }} · Brevete</span><span class="mono">{{ ch.numeroDocumentoIdentidad }}{% if ch.licencia is not empty %} · {{ ch.licencia }}{% endif %}</span></div>
          {% endfor %}{% endif %}
        </div>
      </div>
    </section>

    <table class="items" data-fragment="items-head">
      <thead>
        <tr>
          <th class="c-idx">#</th>
          <th class="c-code">Código</th>
          <th>Descripción del bien</th>
          <th class="c-unit">Und</th>
          <th class="c-qty">Cantidad</th>
        </tr>
      </thead>
    </table>

    {% for det in doc.detalles %}
    <template data-fragment="item-row">
    <tr>
      <td class="c-idx mono">{{ (loop.index + 1)|str_pad(2, '0', 'left') }}</td>
      <td class="c-code mono">{{ det.codigo }}</td>
      <td class="desc">
        <div class="main">{{ det.descripcion }}</div>
        {% if det.codigoSunat is not empty %}<div class="sub">SUNAT {{ det.codigoSunat }}</div>{% endif %}
      </td>
      <td class="c-unit">{{ det.unidadMedida }}</td>
      <td class="c-qty mono">{{ det.cantidad|q_format }}</td>
    </tr>
    </template>
    {% endfor %}

    {% if params.totalGuia is not null %}
    <div class="freight-summary" data-fragment="closing">
      <span class="k">Flete</span><span class="v">S/ {{ params.totalGuia|n_format }}</span>
    </div>
    {% endif %}

    {% if hasClosing %}
    <div class="related" data-fragment="closing">
      {% if doc.documentosRelacionados is not empty %}
      <div class="block">
        <div class="head">Documentos relacionados</div>
        <div class="body">
          {% for rel in doc.documentosRelacionados %}
          <p>{{ rel.tipoDocumento }} · <span class="mono">{{ rel.serieNumero }}</span></p>
          {% endfor %}
        </div>
      </div>
      {% endif %}
      {% if doc.observaciones is not empty %}
      <div class="block">
        <div class="head">Observaciones</div>
        <div class="body">
          {% for obs in doc.observaciones|split('\n') %}<p class="small">· {{ obs }}</p>{% endfor %}
        </div>
      </div>
      {% endif %}
    </div>
    {% endif %}

    <div class="foot" data-fragment="closing">
      <div class="qr">
        {% if qrBase64 is not empty %}<img src="data:image/png;base64,{{ qrBase64 }}" alt="QR Code" />{% endif %}
      </div>
      <div class="meta">
        <p><strong>Representación impresa</strong> de la Guía de Remisión Transportista Electrónica.</p>
        <p>Consulte la validez en <strong>{{ params.consultaUrl|default('sunat.gob.pe') }}</strong> con el RUC del transportista y el número del documento.</p>
        <p>Firmante: {% if cp is not null %}{{ cp.ruc }} · {{ cp.razonSocial }}{% endif %}</p>
        {% if hashDocumento is not empty %}<p class="hash">Hash: {{ hashDocumento }}</p>{% endif %}
        {% if params.footer is not null %}<p id="custom-footer-box">{{ params.footer }}</p>{% endif %}
      </div>
      <div class="stamp">
        <span class="badge">{{ params.estadoGreT|default('GRE-T PENDIENTE') }}</span>
        <div class="line">Documento electrónico emitido conforme a la RS SUNAT 271-2019.</div>
      </div>
    </div>
  </div>
</div>

<div id="gre-pages"></div>

<script>
window.__ublkitRenderReady = false;
(async function () {
  const source = document.getElementById('gre-source');
  const root = document.getElementById('gre-pages');
  if (!source || !root) {
    window.__ublkitRenderReady = true;
    return;
  }
  if (document.fonts && document.fonts.ready) {
    await document.fonts.ready;
  }
  await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));

  const fullHeader = source.querySelector('[data-fragment="full-header"]');
  const compactHeader = source.querySelector('[data-fragment="compact-header"]');
  const introBlocks = Array.from(source.querySelectorAll('[data-fragment="intro"]'));
  const itemsHead = source.querySelector('[data-fragment="items-head"] thead');
  const itemRows = Array.from(source.querySelectorAll('template[data-fragment="item-row"]'));
  const closingBlocks = Array.from(source.querySelectorAll('[data-fragment="closing"]'));

  function createPage(firstPage) {
    const page = document.createElement('section');
    page.className = 'page' + (firstPage ? ' first-page' : ' continuation-page');
    const shell = document.createElement('div');
    shell.className = 'page-shell';
    page.appendChild(shell);

    shell.appendChild((firstPage ? fullHeader : compactHeader).cloneNode(true));
    if (firstPage) {
      introBlocks.forEach(block => shell.appendChild(block.cloneNode(true)));
    }

    const itemsSection = document.createElement('section');
    itemsSection.className = 'items-section';
    const itemsCard = document.createElement('div');
    itemsCard.className = 'items-card';
    const table = document.createElement('table');
    table.className = 'items';
    table.appendChild(itemsHead.cloneNode(true));
    const tbody = document.createElement('tbody');
    table.appendChild(tbody);
    itemsCard.appendChild(table);
    itemsSection.appendChild(itemsCard);
    shell.appendChild(itemsSection);
    root.appendChild(page);
    return { page, shell, itemsSection, tbody };
  }

  function overflows(state) {
    return state.shell.scrollHeight > (state.shell.clientHeight + 1);
  }

  let current = createPage(true);
  itemRows.forEach(row => {
    const clone = row.content.firstElementChild.cloneNode(true);
    current.tbody.appendChild(clone);
    if (overflows(current)) {
      current.tbody.removeChild(clone);
      current = createPage(false);
      current.tbody.appendChild(clone);
    }
  });

  root.querySelectorAll('.items-section').forEach(section => {
    if (!section.querySelector('tbody').children.length) {
      section.classList.add('is-empty');
    }
  });

  if (closingBlocks.length) {
    const nodes = closingBlocks.map(block => block.cloneNode(true));
    nodes.forEach(node => current.shell.appendChild(node));
    if (overflows(current)) {
      nodes.forEach(node => current.shell.removeChild(node));
      current = createPage(false);
      if (!current.tbody.children.length) {
        current.itemsSection.classList.add('is-empty');
      }
      nodes.forEach(node => current.shell.appendChild(node));
    }
  }

  source.remove();
  window.__ublkitRenderReady = true;
})();
</script>
</body>
</html>
