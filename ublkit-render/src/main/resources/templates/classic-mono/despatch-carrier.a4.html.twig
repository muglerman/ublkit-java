<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
{% set cp = doc.remitente %}
{% set tercero = doc.tercero %}
{% set cl = doc.destinatario %}
{% set name = doc.tipoComprobante|catalog('01') %}
{% set hasSubcontratante = doc.subcontratado is not null and (doc.subcontratado.nombre is not empty or doc.subcontratado.numeroDocumentoIdentidad is not empty or doc.subcontratado.numeroRegistroMTC is not empty) %}
{% set hasSubcontratista = params.subcontratistaNombre is not empty or params.subcontratistaRuc is not empty or params.subcontratistaMtc is not empty %}
{% set hasSubcontratacion = hasSubcontratante or hasSubcontratista %}
{% set hasIndicadoresTraslado = indicadoresTraslado is defined and indicadoresTraslado is not empty %}
<title>{{ doc.serie }}-{{ doc.numero|str_pad(8, '0', 'left') }} · {{ name }}</title>
<style>
  {{ fontStyle | raw }}
  * { box-sizing: border-box; }
  html, body { margin: 0; }
  body { font-family: 'Inter', sans-serif; font-size: 10.5px; line-height: 1.45; color: #0a0a0a; background: #fff; padding: 32px 36px; width: 794px; min-height: 1123px; }
  .mono { font-family: 'IBM Plex Mono', monospace; font-variant-numeric: tabular-nums; }
  h1, h2, h3 { margin: 0; font-weight: 600; }
  p { margin: 0; }

  .masthead { display: grid; grid-template-columns: 1fr auto; align-items: start; gap: 24px; padding-bottom: 18px; border-bottom: 2px solid #0a0a0a; }
  .brand .mark { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
  .brand .mark .logo { width: 56px; height: 56px; color: #0a0a0a; }
  .brand .mark .name { font-size: 13px; font-weight: 700; letter-spacing: 0.02em; }
  .brand .meta { display: grid; grid-template-columns: 96px 1fr; column-gap: 16px; row-gap: 2px; font-size: 10px; margin: 0; }
  .brand .meta dt { text-transform: uppercase; letter-spacing: 0.08em; font-size: 9px; color: #737373; }
  .brand .meta dd { margin: 0; color: #0a0a0a; }

  .doc-id { text-align: right; min-width: 250px; }
  .doc-id .ruc { font-size: 10px; color: #737373; text-transform: uppercase; letter-spacing: 0.1em; }
  .doc-id .ruc strong { color: #0a0a0a; font-family: 'IBM Plex Mono', monospace; letter-spacing: 0.02em; }
  .doc-id .kind { font-size: 16px; font-weight: 700; letter-spacing: 0.02em; margin-top: 2px; line-height: 1.15; }
  .doc-id .sub { font-size: 10px; color: #525252; text-transform: uppercase; letter-spacing: 0.1em; }
  .doc-id .num { font-family: 'IBM Plex Mono', monospace; font-size: 22px; font-weight: 600; margin-top: 6px; letter-spacing: 0.04em; }
  .doc-id .aux { margin-top: 6px; font-size: 10px; color: #404040; }
  .doc-id .aux .label { color: #737373; text-transform: uppercase; letter-spacing: 0.06em; font-size: 9px; margin-right: 6px; }
  .doc-id .issued { margin-top: 8px; font-size: 10px; color: #404040; }

  .route { display: grid; grid-template-columns: 1fr 28px 1fr; gap: 16px; align-items: center; padding: 16px 0; border-bottom: 1px solid #0a0a0a; }
  .route .leg .k { font-size: 9px; text-transform: uppercase; letter-spacing: 0.14em; color: #737373; }
  .route .leg .v { font-size: 12px; font-weight: 600; margin-top: 2px; }
  .route .leg .a { font-size: 10px; color: #525252; margin-top: 1px; }
  .route .arrow { text-align: center; font-size: 20px; color: #0a0a0a; }
  .route .leg.right { text-align: right; }

  .parties { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; padding: 18px 0; border-bottom: 1px solid #0a0a0a; }
  .party .label { font-size: 9px; text-transform: uppercase; letter-spacing: 0.14em; color: #737373; margin-bottom: 6px; }
  .party .name { font-size: 11.5px; font-weight: 600; margin-bottom: 4px; }
  .party .row { display: flex; gap: 10px; font-size: 10px; margin-top: 2px; }
  .party .row span:first-child { color: #737373; min-width: 70px; text-transform: uppercase; letter-spacing: 0.06em; font-size: 9px; }

  .strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 14px 18px; padding: 10px 0; border-bottom: 1px solid #0a0a0a; font-size: 10px; }
  .strip > div .k { display: block; font-size: 9px; color: #737373; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 2px; }
  .strip > div .v { color: #0a0a0a; font-weight: 500; }
  .tracking-number { font-size: 14px !important; font-weight: 700 !important; letter-spacing: 0.03em; }

  .stack-card { padding: 16px 0; border-bottom: 1px solid #0a0a0a; }
  .stack-card .head { font-size: 9px; text-transform: uppercase; letter-spacing: 0.14em; color: #737373; margin-bottom: 6px; }
  .stack-card .name { font-size: 11.5px; font-weight: 600; margin-bottom: 4px; }
  .stack-card .row { display: flex; gap: 10px; font-size: 10px; margin-top: 2px; }
  .stack-card .row span:first-child { color: #737373; min-width: 86px; text-transform: uppercase; letter-spacing: 0.06em; font-size: 9px; }
  .subcontract-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; }
  .subcontract-fields { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .subcontract-field .k { display: block; color: #737373; text-transform: uppercase; letter-spacing: 0.06em; font-size: 9px; }
  .subcontract-field .v { display: block; margin-top: 2px; font-size: 10px; overflow-wrap: anywhere; }
  .indicator-list { display: flex; flex-wrap: wrap; gap: 8px; }
  .indicator { border: 1px solid #0a0a0a; padding: 4px 8px; font-size: 9.5px; }

  .twocol { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; padding: 16px 0; border-bottom: 1px solid #0a0a0a; }
  .twocol .block .head { font-size: 9px; text-transform: uppercase; letter-spacing: 0.14em; color: #737373; margin-bottom: 6px; }
  .twocol .block .row { display: flex; gap: 10px; font-size: 10px; margin-top: 2px; }
  .twocol .block .row span:first-child { color: #737373; min-width: 86px; text-transform: uppercase; letter-spacing: 0.06em; font-size: 9px; }

  .items { width: 100%; border-collapse: collapse; margin-top: 16px; }
  .items thead th { font-size: 9px; text-transform: uppercase; letter-spacing: 0.1em; color: #737373; font-weight: 500; text-align: left; padding: 0 8px 8px 0; border-bottom: 1px solid #0a0a0a; }
  .items tbody td { padding: 10px 8px 10px 0; border-bottom: 1px dashed #d4d4d4; vertical-align: top; font-size: 10.5px; }
  .items .c-idx { width: 24px; color: #a3a3a3; }
  .items .c-code { width: 86px; }
  .items .c-qty, .items .c-unit { text-align: right; }
  .items .c-unit { width: 50px; text-align: center; color: #737373; }
  .items .c-qty { width: 70px; padding-right: 0; }
  .items .desc .main { font-weight: 500; }
  .items .desc .sub { font-size: 9.5px; color: #737373; margin-top: 2px; }
  .freight-summary { display: flex; justify-content: flex-end; gap: 12px; padding: 8px 0; border-bottom: 1px solid #0a0a0a; font-size: 10px; }
  .freight-summary .k { color: #737373; text-transform: uppercase; letter-spacing: 0.1em; font-size: 9px; }
  .freight-summary .v { font-weight: 600; }
  .vehicle-entry { padding: 3px 0; }
  .vehicle-entry + .vehicle-entry { margin-top: 4px; padding-top: 6px; border-top: 1px dashed #d4d4d4; }
  .vehicle-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 5px 12px; }
  .vehicle-field { display: flex; align-items: baseline; gap: 4px; min-width: 0; white-space: nowrap; }
  .vehicle-field .k { display: inline; flex: 0 0 auto; color: #737373; text-transform: uppercase; letter-spacing: 0.06em; font-size: 9px; }
  .vehicle-field .v { display: inline; min-width: 0; margin-top: 0; font-size: 10px; }

  .related { margin-top: 18px; padding: 12px 0; border-top: 1px solid #0a0a0a; border-bottom: 1px solid #0a0a0a; display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .related .block .head { font-size: 9px; text-transform: uppercase; letter-spacing: 0.14em; color: #737373; margin-bottom: 5px; }
  .related .block .body { font-size: 10px; }
  .related .block .body p { padding: 1px 0; }
  .related .small { font-size: 9.5px; color: #525252; }

  .foot { display: grid; grid-template-columns: 90px 1fr auto; gap: 16px; align-items: start; margin-top: 22px; padding-top: 16px; border-top: 2px solid #0a0a0a; }
  .foot .qr { width: 90px; height: 90px; border: 1px solid #0a0a0a; padding: 4px; }
  .foot .qr img { width: 100%; height: 100%; display: block; }
  .foot .meta { font-size: 9.5px; color: #525252; }
  .foot .meta strong { color: #0a0a0a; }
  .foot .meta .hash { font-family: 'IBM Plex Mono', monospace; word-break: break-all; font-size: 9px; margin-top: 2px; }
  .foot .stamp { text-align: right; }
  .foot .stamp .badge { display: inline-block; border: 1px solid #0a0a0a; padding: 4px 10px; font-size: 9px; text-transform: uppercase; letter-spacing: 0.14em; }
  .foot .stamp .line { font-size: 9.5px; color: #525252; margin-top: 6px; max-width: 180px; }
</style>
</head>
<body>

<div class="masthead">
  <div class="brand">
    <div class="mark">
      {% if params.logo is not empty %}<img class="logo" src="{{ params.logo }}" alt="logo" style="object-fit:contain"/>{% else %}<svg class="logo" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="20" cy="20" r="14"/><path d="M9 23l5-9 6 4 6-7"/></svg>{% endif %}
      <div class="name">{% if cp is not null %}{{ cp.razonSocial }}{% endif %}</div>
    </div>
    <dl class="meta">
      {% if cp is not null and cp.direccion is not null %}<dt>Dirección</dt><dd class="issuer-address">{{ cp.direccion.direccion }}{% if cp.direccion.departamento is not empty %}{% if cp.direccion.direccion is not empty %} · {% endif %}{{ cp.direccion.departamento }}{% endif %}{% if cp.direccion.provincia is not empty %}{% if cp.direccion.direccion is not empty or cp.direccion.departamento is not empty %} · {% endif %}{{ cp.direccion.provincia }}{% endif %}{% if cp.direccion.distrito is not empty %}{% if cp.direccion.direccion is not empty or cp.direccion.departamento is not empty or cp.direccion.provincia is not empty %} · {% endif %}{{ cp.direccion.distrito }}{% endif %}{% if cp.direccion.ubigeo is not empty %}{% if cp.direccion.direccion is not empty or cp.direccion.departamento is not empty or cp.direccion.provincia is not empty or cp.direccion.distrito is not empty %} · {% endif %}Ubigeo {{ cp.direccion.ubigeo }}{% endif %}</dd>{% endif %}
      {% if cp is not null and cp.contacto is not null and (cp.contacto.email is not empty or cp.contacto.telefono is not empty) %}<dt>Contacto</dt><dd class="issuer-contact">{% if cp.contacto.email is not empty %}{{ cp.contacto.email }}{% endif %}{% if cp.contacto.email is not empty and cp.contacto.telefono is not empty %} · {% endif %}{% if cp.contacto.telefono is not empty %}{{ cp.contacto.telefono }}{% endif %}</dd>{% endif %}
      {% if doc.envio is not null and doc.envio.transportista is not null and doc.envio.transportista.numeroRegistroMTC is not empty %}<dt>Reg. MTC</dt><dd class="issuer-mtc mono">{{ doc.envio.transportista.numeroRegistroMTC }}</dd>{% endif %}
    </dl>
  </div>
  <div class="doc-id">
    <div class="ruc">RUC <strong>{% if cp is not null %}{{ cp.ruc }}{% endif %}</strong></div>
    <div class="kind">{{ name|upper }} ELECTRÓNICA</div>
    <div class="num">{{ doc.serie }} — {{ doc.numero|str_pad(8, '0', 'left') }}</div>
    {% if params.estadoPago is not empty %}<div class="aux"><span class="label">Estado de pago</span>{{ params.estadoPago }}</div>{% endif %}
    {% if params.trackingNumber is not empty %}<div class="aux tracking-number"><span class="label">Nro. tracking</span><span class="mono">{{ params.trackingNumber }}</span></div>{% endif %}
    <div class="issued">Emitido {{ doc.fechaEmision|date('d/m/Y') }}{% if doc.horaEmision is not null %} · {{ doc.horaEmision }}{% endif %}</div>
  </div>
</div>

<div class="route">
  <div class="leg">
    <div class="k">Punto de partida</div>
    <div class="v">{% if doc.envio is not null and doc.envio.partida is not null %}{{ doc.envio.partida.direccion }}{% endif %}</div>
    <div class="a">{% if params.partidaDistrito is not empty %}{% if params.partidaDepartamento is not empty %}{{ params.partidaDepartamento }} — {{ params.partidaProvincia }} — {% endif %}{{ params.partidaDistrito }}{% endif %}{% if doc.envio is not null and doc.envio.partida is not null and doc.envio.partida.ubigeo is not empty %} · Ubigeo {{ doc.envio.partida.ubigeo }}{% endif %}</div>
  </div>
  <div class="arrow">→</div>
  <div class="leg right">
    <div class="k">Punto de llegada</div>
    <div class="v">{% if doc.envio is not null and doc.envio.destino is not null %}{{ doc.envio.destino.direccion }}{% endif %}</div>
    <div class="a">{% if params.destinoDistrito is not empty %}{% if params.destinoDepartamento is not empty %}{{ params.destinoDepartamento }} — {{ params.destinoProvincia }} — {% endif %}{{ params.destinoDistrito }}{% endif %}{% if doc.envio is not null and doc.envio.destino is not null and doc.envio.destino.ubigeo is not empty %} · Ubigeo {{ doc.envio.destino.ubigeo }}{% endif %}</div>
  </div>
</div>

<div class="parties">
  <div class="party">
    <div class="label">Remitente</div>
    {% if tercero is not null %}
    <div class="name">{{ tercero.nombre }}</div>
    <div class="row"><span>{{ tercero.tipoDocumentoIdentidad|catalogAttr('06','abreviatura') }}</span><span class="mono">{{ tercero.numeroDocumentoIdentidad }}</span></div>
    {% endif %}
  </div>
  <div class="party">
    <div class="label">Destinatario</div>
    {% if cl is not null %}
    <div class="name">{{ cl.nombre }}</div>
    <div class="row"><span>{{ cl.tipoDocumentoIdentidad|catalogAttr('06','abreviatura') }}</span><span class="mono">{{ cl.numeroDocumentoIdentidad }}</span></div>
    {% endif %}
  </div>
</div>

<div class="strip">
  <div><span class="k">Inicio traslado</span><span class="v">{% if doc.envio is not null and doc.envio.fechaTraslado is not null %}{{ doc.envio.fechaTraslado|date('d/m/Y') }}{% endif %}</span></div>
  <div><span class="k">Modalidad</span><span class="v">{% if doc.envio is not null %}{{ doc.envio.tipoModalidadTraslado|catalog('18') }}{% endif %}</span></div>
  <div><span class="k">Peso bruto</span><span class="v">{% if doc.envio is not null %}{{ doc.envio.pesoTotal }} {{ doc.envio.pesoTotalUnidadMedida }}{% endif %}</span></div>
  <div><span class="k">Bultos</span><span class="v">{% if doc.envio is not null and doc.envio.numeroDeBultos is not null %}{{ doc.envio.numeroDeBultos }}{% endif %}</span></div>
</div>

{% if hasIndicadoresTraslado %}
<div class="stack-card">
  <div class="head">Indicadores de traslado</div>
  <div class="indicator-list">
    {% for indicador in indicadoresTraslado %}
    <span class="indicator">{{ indicador }}</span>
    {% endfor %}
  </div>
</div>
{% endif %}

{% if hasSubcontratacion %}
<div class="stack-card">
  <div class="head">Subcontratación</div>
  <div class="subcontract-grid">
    {% if hasSubcontratante %}
    <div>
      <div class="name">Subcontratante</div>
      <div class="subcontract-fields">
        {% if doc.subcontratado.nombre is not empty %}<div class="subcontract-field"><span class="k">Nombre</span><span class="v">{{ doc.subcontratado.nombre }}</span></div>{% endif %}
        {% if doc.subcontratado.numeroDocumentoIdentidad is not empty %}<div class="subcontract-field"><span class="k">RUC</span><span class="v mono">{{ doc.subcontratado.numeroDocumentoIdentidad }}</span></div>{% endif %}
        {% if doc.subcontratado.numeroRegistroMTC is not empty %}<div class="subcontract-field"><span class="k">REG. MTC</span><span class="v mono">{{ doc.subcontratado.numeroRegistroMTC }}</span></div>{% endif %}
      </div>
    </div>
    {% endif %}
    {% if hasSubcontratista %}
    <div>
      <div class="name">Subcontratista</div>
      <div class="subcontract-fields">
        {% if params.subcontratistaNombre is not empty %}<div class="subcontract-field"><span class="k">Nombre</span><span class="v">{{ params.subcontratistaNombre }}</span></div>{% endif %}
        {% if params.subcontratistaRuc is not empty %}<div class="subcontract-field"><span class="k">RUC</span><span class="v mono">{{ params.subcontratistaRuc }}</span></div>{% endif %}
        {% if params.subcontratistaMtc is not empty %}<div class="subcontract-field"><span class="k">REG. MTC</span><span class="v mono">{{ params.subcontratistaMtc }}</span></div>{% endif %}
      </div>
    </div>
    {% endif %}
  </div>
</div>
{% endif %}

<div class="twocol">
  <div class="block">
    <div class="head">Vehículos</div>
    {% if doc.envio is not null and doc.envio.vehiculo is not null %}
    {% set vp = doc.envio.vehiculo %}
    <div class="vehicle-entry"><div class="vehicle-fields"><div class="vehicle-field"><span class="k">Placa</span><span class="v mono">{{ vp.placa }}</span></div>{% if vp.numeroCirculacion is not empty %}<div class="vehicle-field"><span class="k">TUC/CHV</span><span class="v mono">{{ vp.numeroCirculacion }}</span></div>{% endif %}{% if vp.marca is not empty %}<div class="vehicle-field"><span class="k">Marca</span><span class="v">{{ vp.marca }}</span></div>{% endif %}{% if vp.modelo is not empty %}<div class="vehicle-field"><span class="k">Modelo</span><span class="v">{{ vp.modelo }}</span></div>{% endif %}{% if vp.numeroAutorizacion is not empty %}<div class="vehicle-field"><span class="k">Autorización</span><span class="v mono">{{ vp.numeroAutorizacion }}</span></div>{% endif %}</div></div>
    {% if vp.secundarios is not empty %}{% for v in vp.secundarios %}<div class="vehicle-entry"><div class="vehicle-fields"><div class="vehicle-field"><span class="k">Placa secundaria</span><span class="v mono">{{ v.placa }}</span></div>{% if v.numeroCirculacion is not empty %}<div class="vehicle-field"><span class="k">TUC/CHV</span><span class="v mono">{{ v.numeroCirculacion }}</span></div>{% endif %}{% if v.marca is not empty %}<div class="vehicle-field"><span class="k">Marca</span><span class="v">{{ v.marca }}</span></div>{% endif %}{% if v.modelo is not empty %}<div class="vehicle-field"><span class="k">Modelo</span><span class="v">{{ v.modelo }}</span></div>{% endif %}{% if v.numeroAutorizacion is not empty %}<div class="vehicle-field"><span class="k">Autorización</span><span class="v mono">{{ v.numeroAutorizacion }}</span></div>{% endif %}</div></div>{% endfor %}{% endif %}
    {% endif %}
  </div>
  <div class="block">
    <div class="head">Conductores</div>
    {% if doc.envio is not null and doc.envio.choferes is not empty %}{% for ch in doc.envio.choferes %}
    <div class="row"><span>{% if loop.first %}Principal{% else %}Secundario{% endif %}</span><span>{{ ch.nombres }} {{ ch.apellidos }}</span></div>
    <div class="row"><span>{{ ch.tipoDocumentoIdentidad|catalogAttr('06','abreviatura') }} · Brevete</span><span class="mono">{{ ch.numeroDocumentoIdentidad }}{% if ch.licencia is not empty %} · {{ ch.licencia }}{% endif %}</span></div>
    {% endfor %}{% endif %}
  </div>
</div>

<table class="items">
  <thead>
    <tr><th class="c-idx">#</th><th class="c-code">Código</th><th>Descripción del bien</th><th class="c-unit">Und</th><th class="c-qty">Cantidad</th></tr>
  </thead>
  <tbody>
    {% for det in doc.detalles %}
    <tr>
      <td class="c-idx mono">{{ (loop.index + 1)|str_pad(2, '0', 'left') }}</td>
      <td class="c-code mono">{{ det.codigo }}</td>
      <td class="desc"><div class="main">{{ det.descripcion }}</div></td>
      <td class="c-unit">{{ det.unidadMedida }}</td>
      <td class="c-qty mono">{{ det.cantidad|q_format }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

{% if params.totalGuia is not null %}<div class="freight-summary"><span class="k">Flete</span><span class="v">S/ {{ params.totalGuia|n_format }}</span></div>{% endif %}

{% if doc.documentosRelacionados is not empty or doc.observaciones is not empty %}
<div class="related">
  {% if doc.documentosRelacionados is not empty %}
  <div class="block">
    <div class="head">Documentos relacionados</div>
    <div class="body">
      {% for rel in doc.documentosRelacionados %}
      <p>{{ rel.tipoDocumento }} · <span class="mono">{{ rel.serieNumero }}</span></p>
      {% endfor %}
    </div>
  </div>
  {% endif %}
  {% if doc.observaciones is not empty %}
  <div class="block">
    <div class="head">Observaciones</div>
    <div class="body">
      {% for obs in doc.observaciones|split('\n') %}<p class="small">· {{ obs }}</p>{% endfor %}
    </div>
  </div>
  {% endif %}
</div>
{% endif %}

<div class="foot">
  <div class="qr">
    {% if qrBase64 is not empty %}<img src="data:image/png;base64,{{ qrBase64 }}" alt="QR Code" />{% endif %}
  </div>
  <div class="meta">
    <p><strong>Representación impresa</strong> de la Guía de Remisión Transportista Electrónica.</p>
    <p>Consulte la validez en <strong>{{ params.consultaUrl|default('sunat.gob.pe') }}</strong> con el RUC del transportista y el número del documento.</p>
    <p style="margin-top:6px;">Firmante: {% if cp is not null %}{{ cp.ruc }} · {{ cp.razonSocial }}{% endif %}</p>
    {% if hashDocumento is not empty %}<p class="hash">Hash: {{ hashDocumento }}</p>{% endif %}
    {% if params.footer is not null %}<p id="custom-footer-box" style="margin-top:10px; font-style:italic;">{{ params.footer }}</p>{% endif %}
  </div>
  <div class="stamp">
    <span class="badge">GRE-T válida</span>
    <div class="line">Documento electrónico emitido conforme a la RS SUNAT 271-2019.</div>
  </div>
</div>

</body>
</html>
