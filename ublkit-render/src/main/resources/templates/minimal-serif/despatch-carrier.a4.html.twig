<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
{% set cp = doc.remitente %}
{% set tercero = doc.tercero %}
{% set cl = doc.destinatario %}
{% set name = doc.tipoComprobante|catalog('01') %}
{% set docNumber = doc.serie ~ '-' ~ (doc.numero|str_pad(8, '0', 'left')) %}
{% set hasSubcontratante = doc.subcontratado is not null and (doc.subcontratado.nombre is not empty or doc.subcontratado.numeroDocumentoIdentidad is not empty or doc.subcontratado.numeroRegistroMTC is not empty) %}
{% set hasSubcontratista = params.subcontratistaNombre is not empty or params.subcontratistaRuc is not empty or params.subcontratistaMtc is not empty %}
{% set hasSubcontratacion = hasSubcontratante or hasSubcontratista %}
{% set hasIndicadoresTraslado = indicadoresTraslado is defined and indicadoresTraslado is not empty %}
{% set hasClosing = doc.documentosRelacionados is not empty or doc.observaciones is not empty %}
<title>{{ docNumber }} · {{ name }}</title>
<style>
  {{ fontStyle | raw }}
  @page { size: A4 portrait; margin: 0; }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: #fbfaf6; }
  :root {
    --page-width: 794px;
    --page-height: 1123px;
    --ink: #161411;
    --ink-2: #57524b;
    --ink-3: #8c857c;
    --paper: #fbfaf6;
    --rule: #161411;
    --line: #e6e2d9;
    --accent: #2f5a4a;
  }
  body { font-family: 'Inter', sans-serif; font-size: 10.5px; line-height: 1.5; color: var(--ink); background: var(--paper); width: var(--page-width); margin: 0 auto; }
  .mono { font-family: 'JetBrains Mono', monospace; font-variant-numeric: tabular-nums; }
  .serif { font-family: 'Newsreader', serif; }
  p { margin: 0; }

  .page { width: var(--page-width); height: var(--page-height); min-height: var(--page-height); padding: 48px 56px; overflow: hidden; background: var(--paper); break-after: page; page-break-after: always; }
  .page:last-child { break-after: auto; page-break-after: auto; }
  .page-shell { height: 100%; display: flex; flex-direction: column; min-height: 0; }
  .source-only { position: fixed; top: 0; left: -200vw; width: var(--page-width); visibility: hidden; pointer-events: none; }

  .hero { text-align: center; padding-bottom: 20px; border-bottom: 1px solid var(--rule); }
  .hero .co-name { font-family: 'Newsreader', serif; font-size: 21px; font-weight: 500; letter-spacing: 0.01em; }
  .hero .co-sub { font-size: 10px; color: var(--ink-2); margin-top: 3px; letter-spacing: 0.03em; overflow-wrap: anywhere; }
  .hero .doc-kind { margin-top: 16px; font-family: 'Newsreader', serif; font-style: italic; font-size: 14px; color: var(--ink-2); }
  .hero .doc-sub { font-size: 9.5px; color: var(--ink-3); letter-spacing: 0.12em; text-transform: uppercase; margin-top: 2px; }
  .hero .doc-num { margin-top: 4px; font-family: 'JetBrains Mono', monospace; font-size: 22px; font-weight: 500; letter-spacing: 0.03em; }
  .hero .doc-extra { font-size: 10px; color: var(--ink-2); margin-top: 4px; }
  .hero .doc-extra .label { color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.12em; font-size: 9px; margin-right: 6px; }
  .tracking-number { font-size: 10px !important; font-weight: 500 !important; letter-spacing: 0.02em; }
  .issuer-label { display: inline-block; min-width: 76px; margin-right: 8px; color: var(--ink-3); font-family: 'Inter', sans-serif; font-size: 9px; letter-spacing: .08em; text-transform: uppercase; }

  .continuation-header {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 16px;
    align-items: end;
    padding-bottom: 12px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }
  .continuation-header .tag { font-size: 9px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--ink-3); }
  .continuation-header .ruc { font-size: 10px; color: var(--ink-2); text-transform: uppercase; letter-spacing: 0.12em; }
  .continuation-header .num { font-family: 'JetBrains Mono', monospace; font-size: 20px; font-weight: 500; }

  .route { display: grid; grid-template-columns: 1fr auto 1fr; gap: 24px; align-items: center; padding: 20px 0; border-bottom: 1px solid var(--line); break-inside: avoid; page-break-inside: avoid; }
  .route .leg .k { font-size: 9px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--ink-3); margin-bottom: 3px; }
  .route .leg .v { font-family: 'Newsreader', serif; font-size: 14px; font-weight: 500; overflow-wrap: anywhere; }
  .route .leg .a { font-size: 10px; color: var(--ink-2); margin-top: 1px; overflow-wrap: anywhere; }
  .route .arrow { font-family: 'Newsreader', serif; font-style: italic; color: var(--accent); font-size: 18px; }
  .route .leg.right { text-align: right; }

  .meta-grid { display: grid; grid-template-columns: repeat(4, 1fr); row-gap: 14px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .meta-grid > div { padding: 0 14px; border-left: 1px solid var(--line); }
  .meta-grid > div:nth-child(4n + 1) { padding-left: 0; border-left: 0; }
  .meta-grid > div:nth-child(4n) { padding-right: 0; }
  .meta-grid .k { font-size: 9px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--ink-3); margin-bottom: 3px; }
  .meta-grid .v { font-size: 11px; font-weight: 500; overflow-wrap: anywhere; }

  .parties { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .party .label { font-size: 9px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--ink-3); margin-bottom: 6px; }
  .party .name { font-family: 'Newsreader', serif; font-size: 13px; font-weight: 500; margin-bottom: 6px; overflow-wrap: anywhere; }
  .party .row { display: grid; grid-template-columns: 72px 1fr; font-size: 10px; padding: 1px 0; min-width: 0; }
  .party .row .k { color: var(--ink-3); }
  .party .row span:last-child { min-width: 0; overflow-wrap: anywhere; }

  .info-card { padding: 20px 0; border-bottom: 1px solid var(--line); break-inside: avoid; page-break-inside: avoid; }
  .info-card .head { font-family: 'Newsreader', serif; font-style: italic; font-size: 13px; color: var(--ink-2); margin-bottom: 8px; }
  .info-card .name { font-family: 'Newsreader', serif; font-size: 13px; font-weight: 500; margin-bottom: 6px; overflow-wrap: anywhere; }
  .info-card .row { display: grid; grid-template-columns: 90px 1fr; font-size: 10px; padding: 2px 0; }
  .info-card .row .k { color: var(--ink-3); }
  .info-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; }
  .subcontract-fields { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .subcontract-field .k { display: block; color: var(--ink-3); font-size: 9px; text-transform: uppercase; letter-spacing: 0.12em; }
  .subcontract-field .v { display: block; margin-top: 2px; font-size: 10px; overflow-wrap: anywhere; }
  .indicator-list p { padding: 2px 0; }

  .twocol { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; padding-top: 22px; break-inside: avoid; page-break-inside: avoid; }
  .twocol .block .head { font-family: 'Newsreader', serif; font-style: italic; font-size: 13px; color: var(--ink-2); margin-bottom: 8px; }
  .twocol .block .row { display: grid; grid-template-columns: 90px 1fr; font-size: 10px; padding: 2px 0; }
  .twocol .block .row .k { color: var(--ink-3); }
  .vehicle-entry { padding: 3px 0; }
  .vehicle-entry + .vehicle-entry { margin-top: 5px; padding-top: 7px; border-top: 1px solid var(--line); }
  .vehicle-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 5px 14px; }
  .vehicle-field { display: flex; align-items: baseline; gap: 4px; min-width: 0; white-space: nowrap; }
  .vehicle-field .k { display: inline; flex: 0 0 auto; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.12em; font-size: 9px; }
  .vehicle-field .v { display: inline; min-width: 0; margin-top: 0; font-size: 10px; overflow-wrap: anywhere; white-space: normal; }

  .section { padding-top: 20px; }
  .section-title { font-family: 'Newsreader', serif; font-style: italic; font-size: 13px; color: var(--ink-2); margin-bottom: 10px; }
  .items-section { display: flex; flex-direction: column; min-height: 0; break-inside: avoid; page-break-inside: avoid; }
  .items { width: 100%; border-collapse: collapse; table-layout: fixed; }
  .items thead { display: table-header-group; }
  .items tr { break-inside: avoid; page-break-inside: avoid; }
  .items thead th { font-size: 9px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--ink-3); font-weight: 500; text-align: left; padding: 8px 10px 8px 0; border-bottom: 1px solid var(--rule); }
  .items tbody td { padding: 12px 10px 12px 0; border-bottom: 1px solid var(--line); vertical-align: top; font-size: 10.5px; }
  .items .c-idx { width: 28px; color: var(--ink-3); }
  .items .c-code { width: 86px; }
  .items .c-unit { width: 50px; text-align: center; color: var(--ink-3); }
  .items .c-qty { width: 70px; text-align: right; padding-right: 0; }
  .items .desc .main { font-weight: 500; overflow-wrap: anywhere; }
  .items .desc .sub { font-size: 9.5px; color: var(--ink-3); margin-top: 2px; overflow-wrap: anywhere; }
  .items-section.is-empty .items tbody::after { content: 'Sin bienes consignados'; display: block; padding: 12px 0; color: var(--ink-2); font-size: 10px; }

  .freight-summary { display: flex; justify-content: flex-end; gap: 14px; padding: 10px 0; border-bottom: 1px solid var(--line); break-inside: avoid; page-break-inside: avoid; }
  .freight-summary .k { color: var(--ink-3); font-size: 9px; text-transform: uppercase; letter-spacing: 0.16em; }
  .freight-summary .v { font-size: 11px; font-weight: 500; }

  .related { padding: 20px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; break-inside: avoid; page-break-inside: avoid; }
  .related .block .head { font-size: 9px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--ink-3); margin-bottom: 4px; }
  .related .block .body { font-size: 10px; }
  .related .block .body p { overflow-wrap: anywhere; }
  .related .small { font-size: 9.5px; color: var(--ink-2); }

  .foot { display: grid; grid-template-columns: 90px 1fr auto; gap: 22px; align-items: start; margin-top: auto; padding-top: 18px; border-top: 1px solid var(--line); break-inside: avoid; page-break-inside: avoid; }
  .foot .qr { width: 90px; height: 90px; background: #fff; padding: 4px; border: 1px solid var(--line); }
  .foot .qr img { width: 100%; height: 100%; display: block; }
  .foot .meta { font-size: 9.5px; color: var(--ink-2); }
  .foot .meta strong { color: var(--ink); }
  .foot .meta .hash { font-family: 'JetBrains Mono', monospace; word-break: break-all; font-size: 8.5px; margin-top: 2px; color: var(--ink-3); }
  .foot .stamp { text-align: right; min-width: 180px; }
  .foot .stamp .badge { display: inline-block; color: var(--accent); padding: 4px 0; font-family: 'Newsreader', serif; font-style: italic; font-size: 13px; border-bottom: 1px solid var(--accent); }
  .foot .stamp .line { font-size: 9.5px; color: var(--ink-2); margin-top: 8px; max-width: 180px; }
</style>
</head>
<body>
<div id="gre-source" class="page source-only" aria-hidden="true">
  <div class="page-shell">
    <section data-fragment="full-header">
      <div class="hero">
        <div class="co-name">{% if cp is not null %}{{ cp.razonSocial }}{% endif %}</div>
        {% if cp is not null and cp.direccion is not null %}<div class="co-sub issuer-address"><span class="issuer-label">Dirección</span>{{ cp.direccion.direccion }}</div><div class="co-sub issuer-address"><span class="issuer-label">Ubicación</span>{{ cp.direccion.departamento }}{% if cp.direccion.provincia is not empty %} — {{ cp.direccion.provincia }}{% endif %}{% if cp.direccion.distrito is not empty %} — {{ cp.direccion.distrito }}{% endif %}{% if cp.direccion.ubigeo is not empty %} · {{ cp.direccion.ubigeo }}{% endif %}</div>{% endif %}
        {% if params.establishmentName is not empty %}<div class="co-sub">{{ params.establishmentName }}</div>{% endif %}
        {% if cp is not null and cp.contacto is not null and (cp.contacto.email is not empty or cp.contacto.telefono is not empty) %}<div class="co-sub issuer-contact">{% if cp.contacto.email is not empty %}{{ cp.contacto.email }}{% endif %}{% if cp.contacto.email is not empty and cp.contacto.telefono is not empty %} · {% endif %}{% if cp.contacto.telefono is not empty %}{{ cp.contacto.telefono }}{% endif %}</div>{% endif %}
        {% if doc.envio is not null and doc.envio.transportista is not null and doc.envio.transportista.numeroRegistroMTC is not empty %}<div class="co-sub issuer-mtc"><span class="issuer-label">Reg. MTC</span><span class="mono">{{ doc.envio.transportista.numeroRegistroMTC }}</span></div>{% endif %}
        {% if cp is not null and cp.ruc is not empty %}<div class="co-sub">RUC {{ cp.ruc }}</div>{% endif %}
        <div class="doc-kind">GUÍA DE REMISIÓN TRANSPORTISTA</div>
        <div class="doc-sub">GRE-T electrónica</div>
        <div class="doc-num">{{ docNumber }}</div>
        {% if params.estadoPago is not empty %}<div class="doc-extra"><span class="label">Estado de pago</span>{{ params.estadoPago }}</div>{% endif %}
        {% if params.trackingNumber is not empty %}<div class="doc-extra tracking-number"><span class="label">Nro. tracking</span><span class="mono">{{ params.trackingNumber }}</span></div>{% endif %}
      </div>
    </section>

    <section data-fragment="compact-header">
      <div class="continuation-header">
        <div class="tag">GRE-T · Continuación de bienes transportados</div>
        <div class="ruc">RUC {% if cp is not null %}{{ cp.ruc }}{% endif %}</div>
        <div class="num">{{ docNumber }}</div>
      </div>
    </section>

    <section data-fragment="intro">
      <div class="route">
        <div class="leg">
          <div class="k">Punto de partida</div>
          <div class="v">{% if doc.envio is not null and doc.envio.partida is not null %}{{ doc.envio.partida.direccion }}{% endif %}</div>
          <div class="a">{% if params.partidaDistrito is not empty %}{% if params.partidaDepartamento is not empty %}{{ params.partidaDepartamento }} — {{ params.partidaProvincia }} — {% endif %}{{ params.partidaDistrito }}{% endif %}{% if doc.envio is not null and doc.envio.partida is not null and doc.envio.partida.ubigeo is not empty %} · {{ doc.envio.partida.ubigeo }}{% endif %}</div>
        </div>
        <div class="arrow">hacia →</div>
        <div class="leg right">
          <div class="k">Punto de llegada</div>
          <div class="v">{% if doc.envio is not null and doc.envio.destino is not null %}{{ doc.envio.destino.direccion }}{% endif %}</div>
          <div class="a">{% if params.destinoDistrito is not empty %}{% if params.destinoDepartamento is not empty %}{{ params.destinoDepartamento }} — {{ params.destinoProvincia }} — {% endif %}{{ params.destinoDistrito }}{% endif %}{% if doc.envio is not null and doc.envio.destino is not null and doc.envio.destino.ubigeo is not empty %} · {{ doc.envio.destino.ubigeo }}{% endif %}</div>
        </div>
      </div>
    </section>

    <section data-fragment="intro">
      <div class="parties">
        <div class="party">
          <div class="label">Remitente</div>
          {% if tercero is not null %}
          <div class="name">{{ tercero.nombre }}</div>
          <div class="row"><span class="k">{{ tercero.tipoDocumentoIdentidad|catalogAttr('06','abreviatura') }}</span><span class="mono">{{ tercero.numeroDocumentoIdentidad }}</span></div>
          {% endif %}
        </div>
        <div class="party">
          <div class="label">Destinatario</div>
          {% if cl is not null %}
          <div class="name">{{ cl.nombre }}</div>
          <div class="row"><span class="k">{{ cl.tipoDocumentoIdentidad|catalogAttr('06','abreviatura') }}</span><span class="mono">{{ cl.numeroDocumentoIdentidad }}</span></div>
          {% endif %}
        </div>
      </div>
    </section>

    <section data-fragment="intro">
      <div class="meta-grid">
        <div><div class="k">Inicio</div><div class="v">{% if doc.envio is not null and doc.envio.fechaTraslado is not null %}{{ doc.envio.fechaTraslado|date('d/m/Y') }}{% endif %}</div></div>
        <div><div class="k">Modalidad</div><div class="v">{% if doc.envio is not null %}{{ doc.envio.tipoModalidadTraslado|catalog('18') }}{% endif %}</div></div>
        <div><div class="k">Peso bruto</div><div class="v">{% if doc.envio is not null %}{{ doc.envio.pesoTotal }} {{ doc.envio.pesoTotalUnidadMedida }}{% endif %}</div></div>
        <div><div class="k">Bultos</div><div class="v">{% if doc.envio is not null and doc.envio.numeroDeBultos is not null %}{{ doc.envio.numeroDeBultos }}{% endif %}</div></div>
      </div>
    </section>

    {% if hasIndicadoresTraslado %}
    <section data-fragment="intro">
      <div class="info-card">
        <div class="head">Indicadores de traslado</div>
        <div class="indicator-list">{% for indicador in indicadoresTraslado %}<p>• {{ indicador }}</p>{% endfor %}</div>
      </div>
    </section>
    {% endif %}

    {% if hasSubcontratacion %}
    <section data-fragment="intro">
      <div class="info-card">
        <div class="head">Subcontrataciones del traslado</div>
        <div class="info-grid">
          {% if hasSubcontratante %}
          <div>
            <div class="name">Subcontratación SUNAT · Contratante del transporte</div>
            <div class="subcontract-fields">
              {% if doc.subcontratado.nombre is not empty %}<div class="subcontract-field"><span class="k">Nombre</span><span class="v">{{ doc.subcontratado.nombre }}</span></div>{% endif %}
              {% if doc.subcontratado.numeroDocumentoIdentidad is not empty %}<div class="subcontract-field"><span class="k">RUC</span><span class="v mono">{{ doc.subcontratado.numeroDocumentoIdentidad }}</span></div>{% endif %}
              {% if doc.subcontratado.numeroRegistroMTC is not empty %}<div class="subcontract-field"><span class="k">REG. MTC</span><span class="v mono">{{ doc.subcontratado.numeroRegistroMTC }}</span></div>{% endif %}
            </div>
          </div>
          {% endif %}
          {% if hasSubcontratista %}
          <div>
            <div class="name">Subcontratación interna · Proveedor subcontratado</div>
            <div class="subcontract-fields">
              {% if params.subcontratistaNombre is not empty %}<div class="subcontract-field"><span class="k">Nombre</span><span class="v">{{ params.subcontratistaNombre }}</span></div>{% endif %}
              {% if params.subcontratistaRuc is not empty %}<div class="subcontract-field"><span class="k">RUC</span><span class="v mono">{{ params.subcontratistaRuc }}</span></div>{% endif %}
              {% if params.subcontratistaMtc is not empty %}<div class="subcontract-field"><span class="k">REG. MTC</span><span class="v mono">{{ params.subcontratistaMtc }}</span></div>{% endif %}
            </div>
          </div>
          {% endif %}
        </div>
      </div>
    </section>
    {% endif %}

    <section data-fragment="intro">
      <div class="twocol">
        <div class="block">
          <div class="head">Vehículos</div>
          {% if doc.envio is not null and doc.envio.vehiculo is not null %}
          {% set vp = doc.envio.vehiculo %}
          <div class="vehicle-entry"><div class="vehicle-fields"><div class="vehicle-field"><span class="k">Placa</span><span class="v mono">{{ vp.placa }}</span></div>{% if vp.numeroCirculacion is not empty %}<div class="vehicle-field"><span class="k">TUC/CHV</span><span class="v mono">{{ vp.numeroCirculacion }}</span></div>{% endif %}{% if vp.marca is not empty %}<div class="vehicle-field"><span class="k">Marca</span><span class="v">{{ vp.marca }}</span></div>{% endif %}{% if vp.modelo is not empty %}<div class="vehicle-field"><span class="k">Modelo</span><span class="v">{{ vp.modelo }}</span></div>{% endif %}{% if vp.numeroAutorizacion is not empty %}<div class="vehicle-field"><span class="k">Autorización</span><span class="v mono">{{ vp.numeroAutorizacion }}</span></div>{% endif %}</div></div>
          {% if vp.secundarios is not empty %}{% for v in vp.secundarios %}<div class="vehicle-entry"><div class="vehicle-fields"><div class="vehicle-field"><span class="k">Placa secundaria</span><span class="v mono">{{ v.placa }}</span></div>{% if v.numeroCirculacion is not empty %}<div class="vehicle-field"><span class="k">TUC/CHV</span><span class="v mono">{{ v.numeroCirculacion }}</span></div>{% endif %}{% if v.marca is not empty %}<div class="vehicle-field"><span class="k">Marca</span><span class="v">{{ v.marca }}</span></div>{% endif %}{% if v.modelo is not empty %}<div class="vehicle-field"><span class="k">Modelo</span><span class="v">{{ v.modelo }}</span></div>{% endif %}{% if v.numeroAutorizacion is not empty %}<div class="vehicle-field"><span class="k">Autorización</span><span class="v mono">{{ v.numeroAutorizacion }}</span></div>{% endif %}</div></div>{% endfor %}{% endif %}
          {% endif %}
        </div>
        <div class="block">
          <div class="head">Conductores</div>
          {% if doc.envio is not null and doc.envio.choferes is not empty %}{% for ch in doc.envio.choferes %}
          <div class="row"><span class="k">{% if loop.first %}Principal{% else %}Secundario{% endif %}</span><span>{{ ch.nombres }} {{ ch.apellidos }}</span></div>
          <div class="row"><span class="k">{{ ch.tipoDocumentoIdentidad|catalogAttr('06','abreviatura') }} · Brevete</span><span class="mono">{{ ch.numeroDocumentoIdentidad }}{% if ch.licencia is not empty %} · {{ ch.licencia }}{% endif %}</span></div>
          {% endfor %}{% endif %}
        </div>
      </div>
    </section>

    <section class="section" data-fragment="items-head">
      <div class="section-title">Bienes transportados</div>
      <table class="items">
        <thead>
          <tr><th class="c-idx">#</th><th class="c-code">Código</th><th>Descripción</th><th class="c-unit">Und</th><th class="c-qty">Cant.</th></tr>
        </thead>
      </table>
    </section>

    {% for det in doc.detalles %}
    <template data-fragment="item-row">
    <tr>
      <td class="c-idx mono">{{ (loop.index + 1)|str_pad(2, '0', 'left') }}</td>
      <td class="c-code mono">{{ det.codigo }}</td>
      <td class="desc"><div class="main">{{ det.descripcion }}</div>{% if det.codigoSunat is not empty %}<div class="sub">SUNAT {{ det.codigoSunat }}</div>{% endif %}</td>
      <td class="c-unit">{{ det.unidadMedida }}</td>
      <td class="c-qty mono">{{ det.cantidad|q_format }}</td>
    </tr>
    </template>
    {% endfor %}

    {% if params.totalGuia is not null %}<div class="freight-summary" data-fragment="closing"><span class="k">Flete</span><span class="v">S/ {{ params.totalGuia|n_format }}</span></div>{% endif %}

    {% if hasClosing %}
    <div class="related" data-fragment="closing">
      {% if doc.documentosRelacionados is not empty %}
      <div class="block"><div class="head">Documentos relacionados</div><div class="body">{% for rel in doc.documentosRelacionados %}<p>{{ rel.tipoDocumento }} · <span class="mono">{{ rel.serieNumero }}</span></p>{% endfor %}</div></div>
      {% endif %}
      {% if doc.observaciones is not empty %}
      <div class="block"><div class="head">Observaciones</div><div class="body">{% for obs in doc.observaciones|split('\n') %}<p class="small">· {{ obs }}</p>{% endfor %}</div></div>
      {% endif %}
    </div>
    {% endif %}

    <div class="foot" data-fragment="closing">
      <div class="qr">{% if qrBase64 is not empty %}<img src="data:image/png;base64,{{ qrBase64 }}" alt="QR Code" />{% endif %}</div>
      <div class="meta">
        <p><strong>Representación impresa</strong> de la Guía de Remisión Transportista Electrónica.</p>
        <p>Consulte la validez en <strong>{{ params.consultaUrl|default('sunat.gob.pe') }}</strong> con el RUC del transportista y el número del documento.</p>
        <p style="margin-top:6px;">Firmante: {% if cp is not null %}{{ cp.ruc }} · {{ cp.razonSocial }}{% endif %}</p>
        {% if hashDocumento is not empty %}<p class="hash">Hash: {{ hashDocumento }}</p>{% endif %}
        {% if params.footer is not null %}<p id="custom-footer-box" style="margin-top:10px; font-style:italic;">{{ params.footer }}</p>{% endif %}
      </div>
      <div class="stamp">
        <span class="badge">{{ params.estadoGreT|default('GRE-T PENDIENTE') }}</span>
        <div class="line">Documento electrónico emitido conforme a la RS SUNAT 271-2019.</div>
      </div>
    </div>
  </div>
</div>

<div id="gre-pages"></div>

<script>
window.__ublkitRenderReady = false;
(async function () {
  const source = document.getElementById('gre-source');
  const root = document.getElementById('gre-pages');
  if (!source || !root) {
    window.__ublkitRenderReady = true;
    return;
  }
  if (document.fonts && document.fonts.ready) {
    await document.fonts.ready;
  }
  await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));

  const fullHeader = source.querySelector('[data-fragment="full-header"]');
  const compactHeader = source.querySelector('[data-fragment="compact-header"]');
  const introBlocks = Array.from(source.querySelectorAll('[data-fragment="intro"]'));
  const itemsHeadSection = source.querySelector('[data-fragment="items-head"]');
  const itemRows = Array.from(source.querySelectorAll('template[data-fragment="item-row"]'));
  const closingBlocks = Array.from(source.querySelectorAll('[data-fragment="closing"]'));

  function createPage(firstPage) {
    const page = document.createElement('section');
    page.className = 'page' + (firstPage ? ' first-page' : ' continuation-page');
    const shell = document.createElement('div');
    shell.className = 'page-shell';
    page.appendChild(shell);
    shell.appendChild((firstPage ? fullHeader : compactHeader).cloneNode(true));
    if (firstPage) {
      introBlocks.forEach(block => shell.appendChild(block.cloneNode(true)));
    }
    const itemsSection = document.createElement('section');
    itemsSection.className = 'items-section section';
    if (firstPage) {
      itemsSection.appendChild(itemsHeadSection.querySelector('.section-title').cloneNode(true));
    }
    const table = document.createElement('table');
    table.className = 'items';
    table.appendChild(itemsHeadSection.querySelector('.items thead').cloneNode(true));
    const tbody = document.createElement('tbody');
    table.appendChild(tbody);
    itemsSection.appendChild(table);
    shell.appendChild(itemsSection);
    root.appendChild(page);
    return { shell, itemsSection, tbody };
  }

  function overflows(state) {
    return state.shell.scrollHeight > (state.shell.clientHeight + 1);
  }

  let current = createPage(true);
  itemRows.forEach(row => {
    const clone = row.content.firstElementChild.cloneNode(true);
    current.tbody.appendChild(clone);
    if (overflows(current)) {
      current.tbody.removeChild(clone);
      current = createPage(false);
      current.tbody.appendChild(clone);
    }
  });

  root.querySelectorAll('.items-section').forEach(section => {
    if (!section.querySelector('tbody').children.length) {
      section.classList.add('is-empty');
    }
  });

  if (closingBlocks.length) {
    const nodes = closingBlocks.map(block => block.cloneNode(true));
    nodes.forEach(node => current.shell.appendChild(node));
    if (overflows(current)) {
      nodes.forEach(node => current.shell.removeChild(node));
      current = createPage(false);
      if (!current.tbody.children.length) {
        current.itemsSection.classList.add('is-empty');
      }
      nodes.forEach(node => current.shell.appendChild(node));
    }
  }

  source.remove();
  window.__ublkitRenderReady = true;
})();
</script>
</body>
</html>
